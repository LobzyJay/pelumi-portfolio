---
// The site shell: fonts, meta, the floating nav, and the closing contact card.
import '../styles/theme.css';
import Nav from '../components/Nav.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
import archivo from '../assets/fonts/archivo-variable.woff2?url';
import interTight from '../assets/fonts/inter-tight-variable.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Closing contact card. On by default; only the 404 might opt out. */
  contact?: boolean;
  /** Keep a page out of search results (e.g. the 404). */
  noindex?: boolean;
}
const { title, description, contact = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.name}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Matches the top of every hero, so browser chrome blends into the page. -->
    <meta name="theme-color" content="#f58cb6" />
    <!-- The two faces above the fold, fetched early so text does not reflow. -->
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="pi-skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
      {contact && <Contact />}
    </main>
  </body>
</html>
