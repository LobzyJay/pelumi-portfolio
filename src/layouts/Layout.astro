---
// The site shell: fonts, meta, the floating nav, and the closing contact card.
import '../styles/theme.css';
import Nav from '../components/Nav.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
import archivo from '../assets/fonts/archivo-variable.woff2?url';
import interTight from '../assets/fonts/inter-tight-variable.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Closing contact card. On by default; only the 404 might opt out. */
  contact?: boolean;
  /** Keep a page out of search results (e.g. the 404). */
  noindex?: boolean;
}
const { title, description, contact = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const pageTitle = `${title} — ${site.name}`;

// Structured data: tells Google who she is, what she does and where, so
// search results can show that directly rather than guessing from prose.
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.legalName,
  url: Astro.site?.href,
  image: new URL('/og.png', Astro.site).href,
  jobTitle: 'Global Policy Analyst',
  description: site.positioning,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Washington',
    addressRegion: 'DC',
    addressCountry: 'US',
  },
  sameAs: [site.contact.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Runs before first paint: lets CSS know script is available, so the hero
         lines can wait to be drawn instead of flashing on. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Matches the dusty-rose hero ground, so browser chrome blends into the page. -->
    <meta name="theme-color" content="#f3dcd2" />

    <!-- Open Graph / Twitter: a card showing her name, title and positioning,
         built in the site's own type and colours. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Structured data: who she is, what she does, where — lets Google show
         this directly in results instead of guessing from page text. -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <!-- The two faces above the fold, fetched early so text does not reflow. -->
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="pi-skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
      {contact && <Contact />}
    </main>
    <script>
      import { initPatterns } from '../scripts/pattern-motion';
      import { initReveal } from '../scripts/reveal';
      initPatterns();
      initReveal();
    </script>
    <!-- Vercel Web Analytics — the dependency-free snippet, since this is a
         plain static build with no Vercel adapter. Only collects data once
         "Web Analytics" is turned on for the project in the Vercel dashboard. -->
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
