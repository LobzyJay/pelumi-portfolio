---
import { site } from '../../data/site';

// No Contact item: the contact card closes every page and carries the
// colophon, so it is the footer — a nav link to it would be redundant.
const links = [
  { href: '/signal/work/', label: 'Work' },
  { href: '/signal/about/', label: 'About' },
];
---

<nav class="sg-nav">
  <a href="/signal/" class="sg-nav__brand">{site.name}</a>
  <div class="sg-nav__links">
    {links.map((l) => <a href={l.href} class="sg-nav__link">{l.label}</a>)}
    <a href="/signal/resume/" class="sg-nav__link sg-nav__link--last">{site.ctaResume}</a>
  </div>
</nav>

<style>
  .sg-nav {
    background: var(--sg-ink);
    color: var(--sg-bone);
    height: var(--sg-nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--gutter);
    border-bottom: 1px solid color-mix(in srgb, var(--sg-bone) 45%, transparent);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .sg-nav__links { display: flex; gap: 32px; }

  @media (max-width: 640px) {
    .sg-nav { font-size: 12px; }
    .sg-nav__links { gap: 20px; }
    /* Keep the brand, Work and Résumé; About drops out. */
    .sg-nav__link:not(:first-child):not(.sg-nav__link--last) { display: none; }
  }
</style>
