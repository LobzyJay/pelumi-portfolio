---
// About page photo bento — a masked reveal, not a lightbox (v1 scope per
// plan). Only photos that read as professional for a recruiter-facing site
// are included by default: see the note below.
//
// The zip's `file/` folder also contained two casual, unposed phone photos
// and two formal-event/gown portraits. Neither fits a policy-analyst
// portfolio aimed at D.C. hiring managers and congressional offices, so
// they're left out of this grid rather than included by default — ask
// Pelumi whether she wants any of them added back, or supply additional
// professional shots to round the grid out to five tiles as originally
// planned.
import { Image } from 'astro:assets';
import graduation from '../assets/photos/graduation-ut-tower.jpg';
import studioWide from '../assets/photos/studio-portrait-wide.jpg';

const photos = [
  { src: graduation, alt: 'Pelumi at UT Austin’s Littlefield Fountain, in graduation white, with the UT Tower behind her', caption: 'Graduation · UT Austin', big: true },
  { src: studioWide, alt: 'Pelumi, studio portrait, wider crop', caption: 'Studio, wider crop' },
];
---

<div class="bento">
  {photos.map((p, i) => (
    <figure class="bento__tile" class:list={{ 'bento__tile--big': p.big }} data-reveal data-reveal-group="bento" data-reveal-order={i}>
      <Image src={p.src} alt={p.alt} width={p.big ? 800 : 560} height={p.big ? 1000 : 700} />
      <figcaption class="mono">{p.caption}</figcaption>
    </figure>
  ))}
</div>

<style>
  .bento {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-sm);
  }
  .bento__tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    transition: clip-path var(--dur-reveal) var(--ease-reveal);
  }
  .bento__tile[data-reveal] {
    clip-path: inset(0 0 100% 0);
    opacity: 1;
    transform: none;
  }
  .bento__tile[data-reveal].is-revealed { clip-path: inset(0 0 0% 0); }
  .bento__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }
  .bento__tile figcaption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: var(--space-sm);
    color: var(--sand);
    background: linear-gradient(to top, oklch(0.16 0.02 160 / 0.55), transparent);
    opacity: 0;
    transition: opacity var(--dur-ui) var(--ease-reveal);
  }
  .bento__tile:hover figcaption, .bento__tile:focus-within figcaption { opacity: 1; }

  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr 1fr; }
  }
</style>
