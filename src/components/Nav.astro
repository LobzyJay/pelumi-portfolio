---
// Floating nav pill, fixed so it stays over content on scroll. On phones the
// links collapse behind a "Menu" button that GROWS into a full-screen pink panel.
import Icon from './Icon.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
];
const resume = { href: site.contact.resumePage, label: 'Résumé' };
// /work/<slug>/ counts as "Work"
const current = (href: string) => path === href || path.startsWith(href);
const mailHref = `mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.emailSubject)}`;
---

<div class="pi-nav" data-nav>
  <div class="pi-nav__pill">
    <a class="pi-nav__brand" href="/">{site.name}</a>

    <nav class="pi-nav__links" aria-label="Primary">
      {links.map((l) => (
        <a class="pi-nav__link" href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="pi-nav__cta" href={resume.href} aria-current={current(resume.href) ? 'page' : undefined}>
        <Icon name="document" size={16} />{resume.label}
      </a>
    </nav>

    <button
      class="pi-nav__menu"
      type="button"
      aria-expanded="false"
      aria-controls="pi-menu"
      aria-label="Open menu"
      data-menu-toggle
    >
      <!-- Both words sit in the same spot and swap by sliding and fading, so the
           button keeps one size (the panel grows from its exact rectangle) and
           the change is a motion, not a blink. The words are decoration: the
           button's accessible name is the aria-label the script keeps current. -->
      <span class="pi-nav__label" aria-hidden="true">
        <span class="pi-nav__word pi-nav__word--menu">Menu</span>
        <span class="pi-nav__word pi-nav__word--close">Close</span>
      </span>
    </button>
  </div>
</div>

<div class="pi-menu" id="pi-menu" data-menu hidden>
  <div class="pi-menu__body">
    <nav class="pi-menu__links" aria-label="Menu">
      {[...links, resume].map((l, i) => (
        <a href={l.href} style={`--i:${i}`} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="pi-menu__actions">
      <a class="pi-btn pi-btn--pink" style="--i:3" href={mailHref}><Icon name="mail" />Email</a>
      <a class="pi-btn pi-btn--outline" style="--i:4" href={site.contact.linkedin} target="_blank" rel="noopener me">
        <Icon name="linkedin" />LinkedIn
      </a>
    </div>
  </div>
</div>

<style>
  .pi-nav {
    position: fixed;
    top: var(--nav-top);
    left: 0;
    right: 0;
    z-index: 30;
    padding-inline: var(--gutter);
    /* the wrapper spans the page; only the pill takes clicks */
    pointer-events: none;
  }
  .pi-nav__pill {
    pointer-events: auto;
    max-width: 1600px;
    margin-inline: auto;
    height: var(--nav-h);
    padding: 0 var(--pill-pad-r) 0 var(--pill-pad-l);
    border-radius: 999px;
    color: var(--cream);
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow:
      0 16px 40px rgba(43, 21, 23, 0.22),
      /* a hairline of light along the top edge: the rim of the glass */
      inset 0 1px 0 rgba(255, 247, 239, 0.14);

    /* Solid where the browser can't blur, so text is always readable. */
    background: rgba(43, 21, 23, 0.94);
  }
  /* Glass: a translucent ink over a blur of whatever scrolls beneath, pushed a
     little more saturated so the pink and coral behind it stay lively instead
     of going muddy. The ink is held at 72% so the cream text stays at 6.4:1
     or better even over white (9:1 over the pink); 66% would dip to 5.2:1. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .pi-nav__pill {
      background: rgba(43, 21, 23, 0.72);
      -webkit-backdrop-filter: blur(8px) saturate(1.5);
      backdrop-filter: blur(8px) saturate(1.5);
    }
  }
  /* The brand gives way before the links do: a long name is truncated with
     an ellipsis rather than pushing the links out of the pill. */
  .pi-nav__brand {
    font-size: 17px;
    font-weight: 500;
    min-width: 0;
    margin-right: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pi-nav__links, .pi-nav__menu { flex: none; }

  .pi-nav__links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pi-nav__link { transition: color var(--dur) var(--ease); }
  .pi-nav__link[aria-current='page'] { color: var(--pink); }
  @media (hover: hover) and (pointer: fine) {
    .pi-nav__link:hover { color: var(--pink); }
  }

  .pi-nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--pink);
    color: var(--ink);
    border-radius: 999px;
    padding: 13px 20px;
    transition: background-color var(--dur) var(--ease), transform var(--dur-press) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .pi-nav__cta:hover { background: var(--pink-soft); }
  }
  .pi-nav__cta:active { transform: scale(0.98); }

  /* the menu button only exists below the desktop breakpoint */
  .pi-nav__menu { display: none; }

  @media (max-width: 1023px) {
    .pi-nav__pill { box-shadow: 0 12px 30px rgba(43, 21, 23, 0.22); }
    .pi-nav__brand { font-size: 16px; }
    .pi-nav__links { display: none; }
    .pi-nav__menu {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 44px;
      padding: 0 18px;
      border: 0;
      border-radius: 999px;
      background: var(--pink);
      color: var(--ink);
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      transition: transform var(--dur-press) var(--ease);
    }
    .pi-nav__menu:active { transform: scale(0.98); }

    .pi-nav__label { display: grid; overflow: hidden; line-height: 1.6; }
    .pi-nav__word {
      grid-area: 1 / 1;
      text-align: center;
      transition:
        opacity 240ms var(--ease-out),
        transform 420ms var(--ease-out);
    }
    .pi-nav__word--close { opacity: 0; transform: translateY(105%); }
    .pi-nav__menu[aria-expanded='true'] .pi-nav__word--menu { opacity: 0; transform: translateY(-105%); }
    .pi-nav__menu[aria-expanded='true'] .pi-nav__word--close { opacity: 1; transform: none; }
  }

  /* ---- the header while the menu is open ----------------------------------
     The glass header stays in view above the menu. Dark glass would disappear
     against a brown screen, so while the menu is open it turns to a light frost:
     a faint cream tint, a hairline edge, and the same blur. The pink Menu button
     (now "Close") stays pink, sitting in it. Eased, so the bar and the button
     hand over to the menu instead of snapping. */
  .pi-nav__pill {
    transition:
      background-color 280ms var(--ease),
      box-shadow 280ms var(--ease);
  }
  :global(html[data-menu-open]) .pi-nav__pill {
    background: rgba(255, 247, 239, 0.08);
    box-shadow:
      inset 0 0 0 1px rgba(255, 247, 239, 0.16),
      inset 0 1px 0 rgba(255, 247, 239, 0.22),
      0 16px 40px rgba(0, 0, 0, 0.28);
  }

  /* ---- full-screen menu: a brown card becomes the blade ---------------------
     The panel is brown, exactly the colour of the page's brown cards. menu.ts
     finds the brown card that is on screen, lays the panel over that card's
     rectangle and radius (--t/--r/--b/--l/--br), and the clip opens out to the
     whole screen. At the first frame the panel *is* the card; the card's text
     goes because brown covers it, and the card seems to swell into a blank blade.
     If no brown card is on screen it grows from the Menu button instead.
     Strong ease-in-out: a large movement, slow at both ends, quick through the
     middle. */
  .pi-menu {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: var(--ink);
    color: var(--cream);
    overflow: hidden;
    /* fallback if the script hasn't measured yet: a pill at the top right */
    --t: 12px; --r: 16px; --b: calc(100dvh - 68px); --l: calc(100vw - 100px); --br: 22px;
    clip-path: inset(var(--t) var(--r) var(--b) var(--l) round var(--br));
    opacity: 0;
    /* CLOSING: shrink back onto the card (560ms), and only in the last 160ms
       dissolve, so the card's text reappears as the brown lifts. Quicker than
       opening: slow where you are deciding, fast where the system is responding. */
    transition:
      clip-path 560ms cubic-bezier(0.77, 0, 0.175, 1),
      opacity 160ms linear 400ms;
  }
  .pi-menu.is-open {
    clip-path: inset(0 0 0 0 round 0px);
    opacity: 1;
    /* OPENING: the brown washes over the card in 120ms and the clip is already
       moving 50ms in — no dead time. The curve is fast off the mark and settles
       gently (an "ease-out with a little ease-in"): the screen leaps toward you,
       then glides to a stop. (A symmetrical ease-in-out sat almost still for the
       first 400ms, which read as a pause.) */
    transition:
      clip-path 680ms cubic-bezier(0.32, 0.72, 0, 1) 50ms,
      opacity 120ms linear;
  }
  .pi-menu[hidden] { display: none; }

  .pi-menu__body {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* The menu's content sits in the same box as the header's: it starts where
       the header's text starts and its buttons end where the Close button ends. */
    padding: 108px calc(var(--gutter) + var(--pill-pad-r)) 28px calc(var(--gutter) + var(--pill-pad-l));
    overflow-y: auto;
  }
  .pi-menu__links { display: flex; flex-direction: column; gap: 8px; }
  .pi-menu__links a {
    font-size: 46px;
    line-height: 1.1;
    letter-spacing: -0.04em;
    padding-block: 6px;
  }
  .pi-menu__links a[aria-current='page'] { color: var(--pink); }
  @media (hover: hover) and (pointer: fine) {
    .pi-menu__links a:hover { color: var(--pink); }
  }
  .pi-menu__actions { display: flex; flex-direction: column; gap: 10px; }
  .pi-menu__actions .pi-btn { width: 100%; }

  /* The menu's content arrives once the brown is well underway: each line rises
     and fades in a beat after the one before it. On the way out it leaves fast,
     so the panel shrinks back around an empty shape. */
  .pi-menu__links a,
  .pi-menu__actions > .pi-btn {
    opacity: 0;
    translate: 0 28px;
    transition:
      opacity 180ms linear,
      translate 180ms linear,
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .pi-menu.is-open .pi-menu__links a,
  .pi-menu.is-open .pi-menu__actions > .pi-btn {
    opacity: 1;
    translate: 0 0;
    /* starts 200ms in, while the panel is still opening, and steps down the list
       55ms at a time — the whole thing has settled by about 900ms */
    transition:
      opacity 420ms var(--ease-out) calc(200ms + var(--i, 0) * 55ms),
      translate 520ms var(--ease-out) calc(200ms + var(--i, 0) * 55ms),
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  /* the menu only ever shows on small screens */
  @media (min-width: 1024px) {
    .pi-menu { display: none; }
  }

  /* Reduced motion: no growing, no rising, nothing stepping aside — the screen
     simply fades. */
  @media (prefers-reduced-motion: reduce) {
    .pi-menu,
    .pi-menu.is-open { clip-path: none; }
    .pi-menu { transition: opacity 120ms linear; }
    .pi-menu.is-open { transition: opacity 120ms linear; }
    .pi-menu__links a,
    .pi-menu__actions > .pi-btn,
    .pi-menu.is-open .pi-menu__links a,
    .pi-menu.is-open .pi-menu__actions > .pi-btn { opacity: 1; translate: none; transition: none; }
    .pi-nav__cta:active, .pi-nav__menu:active { transform: none; }
    .pi-nav__word { transition: opacity 120ms linear; transform: none !important; }
  }
</style>

<script>
  import { initMenu } from '../scripts/menu';
  initMenu();
</script>
