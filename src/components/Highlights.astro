---
// Home: three featured documents as folded-corner cards on the coral folio
// band, then a hand-off to the full list. The whole card is the link.
//
// States (from the interaction notes): rest; hover lifts 4px and slides the
// arrow 4px right; active drops back to 0, scales .98 and darkens one step for
// 120ms; focus is a 2px pink ring. The fold is a clip-path on an inner face,
// not on the link itself — a clip-path on the link would also clip the
// focus ring.
import FolioBand from './FolioBand.astro';
import Icon from './Icon.astro';
import { cardGraphic, pad, type Doc } from '../data/work';
import options from '../assets/pattern/pi-options.svg?url';
import intercept from '../assets/pattern/pi-intercept.svg?url';
import plan from '../assets/pattern/pi-plan.svg?url';

interface Props {
  docs: Doc[];
  id?: string;
}
const { docs, id } = Astro.props;

const graphics = { 'pi-options': options, 'pi-intercept': intercept, 'pi-plan': plan };
// Featured order from the content model: the sharpest memo, the signature
// theme, and the one real-world deliverable.
const FEATURED = ['autonomous-targeting', 'cyber-enabled-trafficking', 'shared-hope-field-report'];
const picked = FEATURED.map((slug) => docs.find((d) => d.id === slug)).filter((d): d is Doc => Boolean(d));
---

<section class="hl" id={id}>
  <FolioBand>
    <div class="hl__inner">
      <div class="hl__head">
        <h2 class="hl__title">Selected work</h2>
        <span class="hl__count pi-label pi-label--12">Three of {docs.length} · 2025–2026</span>
      </div>

      <div class="hl__cards">
        {picked.map((doc) => {
          const d = doc.data;
          const dark = d.label === 'real';
          return (
            <a class:list={['card', { 'card--dark': dark }]} href={`/work/${doc.id}/`}>
              <span class="card__face">
                <span class="card__art">
                  <img src={graphics[cardGraphic[doc.id]]} alt="" width="210" height="138" loading="lazy" />
                </span>
                <span class="card__meta pi-label">{pad(d.order)} · {d.format} · {d.dateLabel}</span>
                <span class="card__question">{d.question}</span>
                <span class="card__foot">
                  <span class="card__title">{d.title}</span>
                  <span class="card__chip">
                    <span class="card__arrow"><Icon name="arrow-right" tone="ink" /></span>
                  </span>
                </span>
              </span>
            </a>
          );
        })}
      </div>

      <div class="hl__cta">
        <a class="pi-btn pi-btn--ink" href="/work/">See all work<Icon name="arrow-right" tone="cream" /></a>
      </div>
    </div>
  </FolioBand>
</section>

<style>
  .hl__inner {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding: 64px var(--gutter);
  }
  .hl__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .hl__title {
    font-size: 56px;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
    color: #fff;
  }
  .hl__count { color: #fff; }

  .hl__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: 40px;
  }

  /* ---- card ---- */
  .card {
    display: block;
    color: var(--ink);
    transition: transform var(--dur) var(--ease);
  }
  .card__face {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
    min-height: 340px;
    padding: 28px;
    background: var(--cream);
    border-radius: 0 0 20px 20px;
    /* the folded top-right corner */
    clip-path: polygon(0 0, calc(100% - 44px) 0, 100% 44px, 100% 100%, 0 100%);
    transition: background-color var(--dur-press) var(--ease);
  }
  .card--dark { color: var(--cream); }
  .card--dark .card__face { background: var(--ink); }

  .card__art {
    /* content-box on purpose: the artboard is 170px of art plus 16px of
       padding either side, i.e. 202px tall */
    box-sizing: content-box;
    height: 170px;
    border-radius: 14px;
    background: var(--ink);
    display: grid;
    place-items: center;
    padding: 16px;
  }
  .card--dark .card__art { background: rgba(255, 247, 239, 0.06); }
  .card__art img { height: 138px; width: auto; max-width: 100%; }

  .card__meta { color: var(--rust); }
  .card--dark .card__meta { color: var(--pink-soft); }

  .card__question {
    font-size: 27px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .card__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1.5px dashed var(--hair);
  }
  .card--dark .card__foot { border-top-color: var(--hair-pink); }
  .card__title {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--plum);
  }
  .card--dark .card__title { color: var(--pink-soft); }

  .card__chip {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--pink);
    display: grid;
    place-items: center;
  }
  .card__arrow { display: block; transition: transform var(--dur) var(--ease); }

  @media (hover: hover) and (pointer: fine) {
    .card:hover { transform: translateY(-4px); }
    .card:hover .card__arrow { transform: translateX(4px); }
  }
  .card:active { transform: translateY(0) scale(0.98); transition-duration: var(--dur-press); }
  .card:active .card__face { background: var(--press-cream); }
  .card--dark:active .card__face { background: var(--press-ink); }

  .hl__cta { display: flex; align-items: center; gap: 24px; margin-top: 40px; }

  /* ---- tablet: 2-up ---- */
  @media (max-width: 1023px) {
    .hl__inner { padding: 40px var(--gutter); }
    .hl__head { display: block; padding-bottom: 8px; }
    .hl__title { font-size: 44px; letter-spacing: -0.04em; }
    .hl__count { display: none; }
    .hl__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }

    /* the phone/tablet artboards drop the dark card, the arrow chip and the
       dashed foot: one cream card style, title as plain text */
    .card--dark { color: var(--ink); }
    .card--dark .card__face { background: var(--cream); }
    .card--dark .card__art { background: var(--ink); }
    .card--dark .card__meta { color: var(--rust); }
    .card--dark .card__title { color: var(--plum); }
    .card--dark:active .card__face { background: var(--press-cream); }

    .card__face {
      gap: 14px;
      min-height: 0;
      padding: 20px;
      border-radius: 0 0 18px 18px;
      clip-path: polygon(0 0, calc(100% - 36px) 0, 100% 36px, 100% 100%, 0 100%);
    }
    .card__art { height: 150px; border-radius: 12px; padding: 14px; }  /* content-box: 178px tall */
    .card__art img { height: 120px; }
    .card__question { font-size: 23px; }
    .card__foot { display: block; padding: 0; border: 0; margin: 0; }
    .card__title { font-size: 14px; font-weight: 400; line-height: 1.45; }
    .card__chip { display: none; }
    .hl__cta { margin-top: 12px; }
    .hl__cta .pi-btn { width: 100%; }
  }
  @media (max-width: 599px) {
    .hl__cards { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .card__arrow { transition: none; }
    .card:hover, .card:hover .card__arrow, .card:active { transform: none; }
  }
</style>
