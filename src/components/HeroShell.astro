---
// The dusty-rose hero ground with the line pattern behind it. Pages put
// their own light card inside; this only owns the ground, the pattern, the
// sizing and the big-screen cap.
//
// On desktop every hero is exactly one screen tall (100dvh), and the card
// fills it — same height on every page, exactly like the home hero. On
// phones the hero hugs its own content instead, so the next section already
// shows at the bottom of the frame. Pages put their own card inside; this
// only owns the ground, the pattern, the sizing and the big-screen cap.
import PatternField from './PatternField.astro';

interface Props {
  size?: 'home' | 'page';
  /** px of ground above the card; clears the floating nav. */
  top?: number;
  bottom?: number;
}
const { size = 'page', top = 108, bottom = 48 } = Astro.props;
---

<header class="pi-hero" data-size={size} style={`--top:${top}px; --bottom:${bottom}px;`}>
  <PatternField variant="links" />
  <div class="pi-hero__inner">
    <slot />
  </div>
</header>

<style>
  .pi-hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-ground);
    padding: var(--top) var(--gutter) var(--bottom);
    /* Every hero is exactly one screen — the artboards are 1440x900 and
       390x844, but the real rule is the viewport itself, whatever its height
       actually is. dvh (not vh) so mobile browser chrome doesn't leave a gap
       or a scroll sliver. The card no longer stretches to fill that box — it
       sits at the bottom, its own size, with the pattern showing above it. */
    height: 100dvh;
    box-sizing: border-box;
    display: flex;
  }

  /* On 1920+ screens the card stops growing and centres; the ground and the
     pattern keep filling edge to edge. Each page's card carries flex:1, so it
     fills this box top to bottom — the same on every page, not sized to
     whatever that page's own content happens to need. */
  .pi-hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* The card arrives after the lines have started drawing: it comes up out of
     the middle of the page, small, and scales to its place. The fade is over
     in the first third so it is never a ghost at full size, and it starts from
     a real shape (a quarter of its size) rather than from nothing. Runs once
     per page load. */
  @media (prefers-reduced-motion: no-preference) {
    .pi-hero__inner > :global(*) {
      transform-origin: 50% 50%;
      animation: pi-zoom 1000ms cubic-bezier(0.22, 1, 0.36, 1) 350ms both;
    }
  }
  @keyframes pi-zoom {
    0% { opacity: 0; transform: scale(0.25); }
    35% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }

  @media (max-width: 1023px) {
    .pi-hero {
      /* Phones hug their content instead of filling the screen: the next
         section is meant to already show at the bottom of the frame. Only
         desktop is held to the exact one-screen rule. */
      height: auto;
      padding: 84px var(--gutter) 24px;
    }
  }
</style>
