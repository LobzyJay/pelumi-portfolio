---
// The pink-to-coral hero ground with the line pattern behind it. Pages put
// their own dark card inside; this only owns the ground, the pattern, the
// sizing and the big-screen cap.
//
// Heroes are sized to their content, not the viewport — the cream section
// starting below the fold is intentional (it signals there is more to
// scroll). Home is at least 900px tall, inner pages at least 720px.
import PatternField from './PatternField.astro';

interface Props {
  size?: 'home' | 'page';
  /** px of ground above the card; clears the floating nav. */
  top?: number;
  bottom?: number;
}
const { size = 'page', top = 108, bottom = 48 } = Astro.props;
---

<header class="pi-hero" data-size={size} style={`--top:${top}px; --bottom:${bottom}px;`}>
  <PatternField variant="links" />
  <div class="pi-hero__inner">
    <slot />
  </div>
</header>

<style>
  .pi-hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-ground);
    padding: var(--top) var(--gutter) var(--bottom);
    /* Every hero is exactly one screen: 900px on desktop, 844px on phones (see
       the media query below). The card no longer stretches to fill that box —
       it sits at the bottom, its own size, with the pattern showing above it. */
    height: 900px;
    box-sizing: border-box;
    display: flex;
  }

  /* On 1920+ screens the card stops growing and centres; the ground and the
     pattern keep filling edge to edge. The card sits at the bottom of the
     frame: the empty space above it is where the pattern lives. */
  .pi-hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* The card arrives after the lines have started drawing: it comes up out of
     the middle of the page, small, and scales to its place. The fade is over
     in the first third so it is never a ghost at full size, and it starts from
     a real shape (a quarter of its size) rather than from nothing. Runs once
     per page load. */
  @media (prefers-reduced-motion: no-preference) {
    .pi-hero__inner > :global(*) {
      transform-origin: 50% 50%;
      animation: pi-zoom 1000ms cubic-bezier(0.22, 1, 0.36, 1) 350ms both;
    }
  }
  @keyframes pi-zoom {
    0% { opacity: 0; transform: scale(0.25); }
    35% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }

  @media (max-width: 1023px) {
    .pi-hero {
      height: 844px;
      padding: 84px var(--gutter) 24px;
    }
  }
</style>
