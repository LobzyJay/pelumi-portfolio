---
// Homepage hero — "Executive summary" / the Hall. Z-path per PRD §7.5.8:
// name (top-left) → portrait (right) → positioning (left, below) → actions.
// Source: Atlas 04 - The Stage.dc.html.
import { Image } from 'astro:assets';
import headshot from '../assets/photos/hero-portrait.jpg';
import { site } from '../data/site';
---

<section class="hall wrap grid-12">
  <div class="hall__text col-span-8">
    <p class="mono" data-reveal data-reveal-group="hall" data-reveal-order="0">{site.kicker}</p>
    <h1 class="hall__name" data-reveal data-reveal-group="hall" data-reveal-order="1">
      {site.name.split(' ')[0]}<br />{site.name.split(' ').slice(1).join(' ')}
    </h1>
    <p class="hall__positioning" data-reveal data-reveal-group="hall" data-reveal-order="2">
      {site.positioning}
    </p>
    <div class="hall__actions" data-reveal data-reveal-group="hall" data-reveal-order="4">
      <a href="#stage" class="pill pill--accent">{site.ctaEnterRooms}</a>
      <a href={site.contact.resumeHref} class="pill">{site.ctaResume}</a>
    </div>
  </div>
  <div class="hall__portrait col-span-4" data-reveal data-reveal-group="hall" data-reveal-order="3">
    <Image src={headshot} alt={site.name} width={720} height={900} loading="eager" fetchpriority="high" />
    <p class="mono hall__caption">{site.metaLine}</p>
  </div>
</section>

<style>
  .hall {
    min-height: calc(100svh - 84px);
    box-sizing: border-box;
    padding-block: var(--space-md) var(--space-xl);
    align-items: end;
  }
  .hall__name {
    font-size: var(--size-name);
    line-height: 0.9;
    font-weight: 600;
    letter-spacing: -0.04em;
    margin-top: var(--space-md);
  }
  .hall__positioning {
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin-top: var(--space-lg);
    color: oklch(0.35 0.02 160);
    max-width: 26ch;
  }
  .hall__actions {
    display: flex;
    gap: 12px;
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }
  .hall__portrait {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-sm);
  }
  .hall__portrait :global(img) {
    width: 100%;
    max-width: 360px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 10%;
    border-radius: var(--radius-lg);
  }
  .hall__caption {
    color: var(--ink-soft);
    line-height: 1.7;
    text-align: right;
  }
  @media (max-width: 640px) {
    .hall {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: var(--space-lg) var(--space-md);
    }
    .hall__portrait {
      order: 2;
      align-items: flex-start;
      margin-top: var(--space-md);
    }
    .hall__caption { text-align: left; }
  }
</style>
