---
// Home hero. The name is set as one size across both lines — the size at
// which the longest line fills the card — centred on desktop, left on phones.
//
// Two styles, chosen by `site.heroNameStyle` (and previewable with
// ?nameStyle=caps|regular):
//   regular  mixed case, regular weight — the artboard
//   caps     condensed, black weight, all caps — the heavy version
// Both are fitted by src/scripts/fit.ts, so any name length or style fits
// without touching the layout.
import HeroShell from './HeroShell.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

// Two lines: the first name, then everything after it. A one-word name
// simply gets one line.
const lines = [site.firstName, site.lastName].filter(Boolean);
// Longest line, in characters. Feeds the pre-fit size estimate in the CSS, so
// the name already fits before (or without) JavaScript.
const chars = Math.max(...lines.map((l) => l.length));
---

<HeroShell size="home" top={108} bottom={64}>
  <div class="hero" data-morph-source>
    <div class="hero__stage">
      <h1
        class="hero__name"
        data-fit-container
        data-fit-ref="200"
        data-fit-max="26"
        data-name-style={site.heroNameStyle}
        style={`--chars:${chars}`}
      >
        {lines.map((line, i) => (
          <span data-fit-line class="pi-enter" style={`--enter-delay:${850 + i * 120}ms`}>{line}</span>
        ))}
      </h1>
    </div>

    <div class="hero__bar pi-grid">
      <p class="hero__pitch pi-enter" style="--enter-delay:1250ms">{site.positioning}</p>
      <div class="hero__aside pi-enter" style="--enter-delay:1400ms">
        <p class="hero__meta pi-label pi-label--12">
          {site.heroMeta[0]}<br />{site.heroMeta[1]}
        </p>
        <a class="pi-btn pi-btn--pink" href="#work">
          Selected work<Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </div>
</HeroShell>

<style>
  .hero {
    flex: 1;
    background: var(--card);
    color: var(--ink);
    border: 1.5px solid var(--hair);
    border-radius: 32px;
    padding: var(--card-y) var(--card-x);
    /* The card's own 12-column grid: the name runs the full width on the first
       row, the pitch and the actions share the second (columns 1-7 and 8-12).
       No divider between them: the grid does the separating. */
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    grid-template-rows: 1fr auto;
    row-gap: 56px;
  }
  .hero__stage {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero__name {
    /* container-type lets fit.ts hand the fit to CSS as a `cqw` value */
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.045em;
    /* average glyph width as a share of the font size, per style. Deliberately
       a little wide: the estimate only has to be safe, never exact. */
    --k: 0.5;
  }
  .hero__name[data-name-style='caps'] {
    text-transform: uppercase;
    font-weight: 900;
    font-stretch: 68%;
    line-height: 0.82;
    letter-spacing: -0.02em;
    --k: 0.56;
  }
  /* Before fit.ts has measured (or with JavaScript off) the name is sized from
     its character count, which can only under-fill the card, never overflow. */
  .hero__name [data-fit-line] {
    white-space: nowrap;
    /* same ceiling as data-fit-max, so the estimate respects it too */
    font-size: min(26cqw, calc(100cqw / (var(--chars) * var(--k))));
  }

  .hero__bar {
    grid-column: 1 / -1;
    /* inherit the card's columns exactly, rather than redrawing an identical grid */
    grid-template-columns: subgrid;
    align-items: end;
  }
  .hero__pitch {
    grid-column: 1 / span 7;
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    max-width: 26ch;
  }
  .hero__aside {
    grid-column: 8 / span 5;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
    text-align: right;
  }
  .hero__meta { color: var(--pink-deep); }

  @media (max-width: 1023px) {
    .hero { flex: none; min-height: 50dvh; border-radius: 24px; display: flex; flex-direction: column; justify-content: center; gap: 20px; }
    .hero__stage { justify-content: flex-start; flex: none; }
    .hero__name { align-items: flex-start; text-align: left; }
    .hero__name:not([data-name-style='caps']) { letter-spacing: -0.05em; }
    /* On phones the name is a normal, modest heading — not fit.ts's
       fill-the-card treatment (built for desktop's one-size-spans-the-card
       look). fit.ts sets the fitted size as an inline style, which beats any
       plain CSS rule, so this needs !important to actually win on phones. */
    .hero__name [data-fit-line] {
      font-size: clamp(36px, 10vw, 48px) !important;
    }
    .hero__bar { display: flex; flex-direction: column; align-items: stretch; gap: 20px; }
    .hero__pitch, .hero__aside { grid-column: auto; }
    .hero__pitch { font-size: 20px; max-width: none; text-wrap: pretty; }
    .hero__aside { align-items: stretch; text-align: left; gap: 12px; }
    .hero__meta { font-size: 11px; }
    .hero__aside .pi-btn { width: 100%; }
  }
</style>

<script>
  import { initFit } from '../scripts/fit';

  // Preview aid: ?nameStyle=caps or ?nameStyle=regular. Only those two exact
  // values are honoured — a URL must never be able to put its own text on
  // the page.
  const requested = new URLSearchParams(location.search).get('nameStyle');
  if (requested === 'caps' || requested === 'regular') {
    document.querySelector<HTMLElement>('.hero__name')?.setAttribute('data-name-style', requested);
  }
  initFit();
</script>
