---
interface Option { title: string; summary: string; verdict: 'chosen' | 'considered' }
interface Props { options: Option[] }
const { options } = Astro.props;
---

<div class="options">
  <p class="mono options__label">Options considered</p>
  <div class="options__grid grid-12">
    {options.map((o) => (
      <div class="option col-span-4" class:list={{ 'option--chosen': o.verdict === 'chosen' }}>
        {o.verdict === 'chosen' && <span class="mono option__tag">Recommended</span>}
        <h3 class="option__title">{o.title}</h3>
        <p class="option__summary">{o.summary}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .options { margin-top: var(--space-xl); }
  .options__label { color: var(--ink-soft); margin-bottom: var(--space-sm); }
  .options__grid { row-gap: var(--space-md); }
  .option {
    border: 1px solid var(--rule);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .option--chosen { border-color: var(--accent); }
  .option__tag {
    color: var(--accent);
    align-self: flex-start;
  }
  .option__title {
    font-size: var(--size-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .option__summary {
    font-size: var(--size-small);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  @media (max-width: 900px) {
    .options__grid { grid-template-columns: 1fr; }
  }
</style>
