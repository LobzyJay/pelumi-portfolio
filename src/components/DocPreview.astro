---
// First-page render + a link to the PDF, or the honest "pending" state for the
// one document whose source file is withheld (doc 06 — see its frontmatter).
// The PDF opens in a new tab, per the interaction notes.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Doc } from '../data/work';

interface Props { doc: Doc }
const { doc } = Astro.props;
const d = doc.data;

// The glob keys are the literal specifier strings, so this lookup path has to
// stay character-identical to the glob below.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/documents/*.png', { eager: true });
const preview = d.previewImage ? images[`../assets/documents/${d.previewImage}.png`]?.default : undefined;
---

<section class="doc">
  <div class="doc__figure">
    {preview ? (
      <Image src={preview} alt={`First page of ${d.title}`} width={520} height={673} />
    ) : (
      <div class="doc__pending"><span class="pi-label">PDF pending</span></div>
    )}
  </div>

  <div class="doc__meta">
    <span class="pi-label pi-label--12">Document</span>
    {d.pdf ? (
      <a class="pi-btn pi-btn--ink" href={d.pdf} target="_blank" rel="noopener">
        Read the full PDF<Icon name="arrow-down" />
      </a>
    ) : (
      <p class="doc__note pi-body">
        This presentation isn't published here yet.
      </p>
    )}
    {d.pages && d.words && (
      <p class="doc__stats pi-label">{d.pages} pages · {d.words.toLocaleString('en-US')} words</p>
    )}
  </div>
</section>

<style>
  .doc {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: start;
  }
  .doc__figure { grid-column: span 4; }
  .doc__figure { border-radius: 20px; overflow: hidden; }
  .doc__figure :global(img) { width: 100%; transition: transform 900ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .doc__figure:hover :global(img) { transform: scale(1.03); }
  }
  .doc__pending {
    aspect-ratio: 4 / 5.18;
    border: 1.5px dashed var(--hair-strong);
    border-radius: 20px;
    display: grid;
    place-items: center;
    opacity: 0.7;
  }
  .doc__meta {
    grid-column: span 8;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .doc__note { font-size: 17px; line-height: 1.5; max-width: 46ch; }
  .doc__stats { opacity: 0.7; }

  @media (max-width: 1023px) {
    .doc { display: flex; flex-direction: column; gap: 12px; }
    .doc__figure {
      background: var(--ink);
      border-radius: 18px;
      padding: 20px;
    }
    .doc__figure :global(img) { border-radius: 6px; }
    .doc__pending { border-color: rgba(255, 247, 239, 0.4); color: var(--cream); border-radius: 6px; }
    .doc__meta { align-items: stretch; gap: 12px; }
    .doc__meta > .pi-label--12 { display: none; }
    .doc__meta .pi-btn { width: 100%; }
    .doc__stats { text-align: center; color: var(--plum); opacity: 1; }
  }
</style>
