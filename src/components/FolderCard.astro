---
// /work index row — the same information as DocList but set as an editorial
// row with a folder-tab meta strip. Source: Atlas 01's "folders" pattern.
import type { CollectionEntry } from 'astro:content';

interface Props {
  doc: CollectionEntry<'work'>;
  index: number;
}
const { doc, index } = Astro.props;
const roomClass = doc.data.room === 'technology' ? 'room-sage' : doc.data.room === 'people' ? 'room-clay' : 'room-sky';
---

<a
  href={`/work/${doc.id}/`}
  class="folder col-span-4"
  data-reveal
  data-reveal-group="work-index"
  data-reveal-order={index}
  data-focus-areas={doc.data.focusAreas.join('|')}
  data-format={doc.data.format}
  data-year={doc.data.date.getFullYear()}
>
  <span class="mono folder__tab" class:list={[roomClass]}>
    {String(doc.data.order).padStart(2, '0')} · {doc.data.format} · {doc.data.dateLabel}
  </span>
  <span class="folder__card">
    <span class="folder__title">{doc.data.title}</span>
    <span class="folder__question">{doc.data.question}</span>
    <span class="mono folder__addressee">{doc.data.addressee}</span>
  </span>
</a>

<style>
  .folder { display: flex; flex-direction: column; }
  .folder__tab {
    width: max-content;
    height: 26px;
    border: 1px solid var(--ink);
    border-bottom: none;
    background: var(--paper);
    display: flex;
    align-items: center;
    padding: 0 14px;
    box-sizing: border-box;
    color: var(--ink);
  }
  .folder__card {
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: var(--space-md);
    min-height: 190px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin-top: -1px;
    gap: var(--space-sm);
    transition: background var(--dur-ui) var(--ease-reveal);
  }
  .folder:hover .folder__card, .folder:focus-visible .folder__card { background: var(--sand-2); }
  .folder__title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .folder__question {
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .folder__addressee { color: var(--ink-soft); }
</style>
