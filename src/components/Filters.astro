---
// Filter pills for /work. Progressive enhancement: without JS every folder
// is shown (server-rendered); filters.ts reads/writes ?focus=&format=&year=
// and shows/hides via the data-* attributes FolderCard already carries.
interface Props {
  focusAreas: string[];
  formats: string[];
  years: number[];
}
const { focusAreas, formats, years } = Astro.props;

const group = (label: string, key: string, values: (string | number)[]) => ({ label, key, values });
const groups = [
  group('Focus area', 'focus', focusAreas),
  group('Format', 'format', formats),
  group('Year', 'year', years),
];
---

<div class="filters" data-filters>
  {groups.map((g) => (
    <div class="filters__group">
      <p class="mono filters__label">{g.label}</p>
      <div class="filters__pills">
        <button type="button" class="filter-pill is-active" data-filter-key={g.key} data-filter-value="">All</button>
        {g.values.map((v) => (
          <button type="button" class="filter-pill" data-filter-key={g.key} data-filter-value={String(v)}>{v}</button>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .filters__label {
    color: var(--ink-soft);
    margin-bottom: 10px;
  }
  .filters__pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 14px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-soft);
    transition: color var(--dur-ui) var(--ease-reveal), border-color var(--dur-ui) var(--ease-reveal);
  }
  .filter-pill.is-active {
    color: var(--ink);
    border-color: var(--accent);
  }
</style>

<script>
  import { initFilters } from '../scripts/filters';
  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>
