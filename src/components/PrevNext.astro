---
import type { CollectionEntry } from 'astro:content';
interface Props {
  prev: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
  total: number;
}
const { prev, next, total } = Astro.props;
---

<nav class="prev-next" aria-label="Other case studies">
  <a href={`/work/${prev.id}/`} class="prev-next__link">
    <span class="mono">← {String(prev.data.order).padStart(2, '0')} — {String(total).padStart(2, '0')}</span>
    <span class="prev-next__title">{prev.data.title}</span>
  </a>
  <a href={`/work/${next.id}/`} class="prev-next__link prev-next__link--next">
    <span class="mono">{String(next.data.order).padStart(2, '0')} — {String(total).padStart(2, '0')} →</span>
    <span class="prev-next__title">{next.data.title}</span>
  </a>
</nav>

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    border-top: 1px solid var(--rule);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
  }
  .prev-next__link { display: flex; flex-direction: column; gap: 8px; }
  .prev-next__link--next { text-align: right; align-items: flex-end; }
  .prev-next__link .mono { color: var(--ink-soft); }
  .prev-next__title {
    font-size: var(--size-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    transition: color var(--dur-ui) var(--ease-reveal);
  }
  .prev-next__link:hover .prev-next__title,
  .prev-next__link:focus-visible .prev-next__title { color: var(--accent); }
  @media (max-width: 640px) {
    .prev-next { grid-template-columns: 1fr; }
    .prev-next__link--next { text-align: left; align-items: flex-start; }
  }
</style>
