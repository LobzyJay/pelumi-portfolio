---
// Three facts in a ledger: what she studied, where she has worked, what she
// has co-written. Facts, not vanity numbers (PRD §11.4).
import { site } from '../data/site';
---

<section class="proof pi-wrap">
  <div class="proof__ledger">
    {site.proof.map((item, i) => (
      <div class="proof__item" data-reveal style={`--reveal-delay:${i * 90}ms`}>
        <div class="proof__head pi-label">
          <span class="proof__kind">{item.kind}</span>
          <span class="proof__n">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <p class="proof__title">{item.title}</p>
        <p class="proof__detail pi-body">{item.detail}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .proof {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding-top: 48px;
  }
  .proof__ledger {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }
  .proof__item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 28px 28px;
  }
  .proof__item:first-child { padding-left: 0; }
  .proof__item + .proof__item { border-left: 1.5px dashed var(--hair); }

  .proof__head { display: flex; justify-content: space-between; gap: 12px; }
  .proof__kind { color: var(--pink-deep); }
  .proof__n { color: var(--plum); }
  .proof__title {
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .proof__detail { font-size: 15px; line-height: 1.45; color: var(--plum); }

  @media (max-width: 1023px) {
    .proof { padding-top: 32px; }
    .proof__ledger { grid-template-columns: 1fr; }
    .proof__item { gap: 8px; padding: 18px 0; }
    .proof__item + .proof__item { border-left: 0; border-top: 1.5px dashed var(--hair); }
    .proof__title { font-size: 22px; line-height: 1.15; letter-spacing: -0.02em; }
    .proof__detail { font-size: 14px; }
  }
</style>
