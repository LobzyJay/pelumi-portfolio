---
// The Platform — master isometric diagram, inlined as one SVG with five
// interactive objects. Faces are classed (not swapped as separate -hi image
// files) so the "hi" tint is a CSS class toggle: see src/scripts/platform.ts
// for the state machine (hover / scroll-active / keyboard / touch / idle
// pulse / reduced motion). Geometry copied verbatim from
// design_handoff_pelumi_site/design/assets/layer-*.svg.
import { platformObjects } from '../data/rooms';

const actionAttrs = (id: string) => {
  const obj = platformObjects.find((o) => o.id === id)!;
  return obj.action.kind === 'room'
    ? { 'data-action-kind': 'room', 'data-action-room': obj.action.room }
    : { 'data-action-kind': 'about' };
};
---

<div class="platform" data-platform>
  <div class="platform__scene">
    <svg viewBox="-335.1 -33 670.2 419" role="group" aria-label="An isometric platform representing Pelumi's work, in five parts">
      <defs>
        <pattern id="iso-stripe" width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
          <path stroke="var(--iso-stroke)" stroke-opacity="0.35" d="M0 0v7" />
        </pattern>
      </defs>

      <!-- platform (base) -->
      <g class="iso-object" data-object="platform" tabindex="0" role="button" aria-label="About Pelumi" {...actionAttrs('platform')}>
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="M-329.1 190 0 380v-22l-329.1-190z" />
        <path class="iso-face iso-face--right" stroke="var(--iso-stroke)" stroke-linejoin="round" d="M329.1 190 0 380v-22l329.1-190z" />
        <path class="iso-face iso-face--top" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m0-22 329.1 190L0 358l-329.1-190z" />
      </g>

      <!-- plan (five-year plan / doc 05) -->
      <g class="iso-object" data-object="plan" tabindex="0" role="button" aria-label="A five-year plan" {...actionAttrs('plan')}>
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m-251.1 183 103.9 60v-30l-103.9-60z" />
        <path class="iso-face iso-face--right" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m-77.9 203-69.3 40v-30l69.3-40z" />
        <path class="iso-face iso-face--accent" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m-181.9 113 104 60-69.3 40-103.9-60z" />
      </g>

      <!-- stack (six documents / work index) -->
      <g class="iso-object" data-object="stack" tabindex="0" role="button" aria-label="Six documents" {...actionAttrs('stack')}>
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m-173.2 118 129.9 75v-3l-129.9-75z" />
        <path class="iso-face iso-face--right" stroke="var(--iso-stroke)" stroke-linejoin="round" d="M129.9 93-43.3 193v-3L129.9 90z" />
        <path class="iso-face iso-face--top" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m0 15 129.9 75-173.2 100-129.9-75z" />
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m-168.9 109.5 129.9 75v-3l-129.9-75z" />
        <path class="iso-face iso-face--right" stroke="var(--iso-stroke)" stroke-linejoin="round" d="M134.2 84.5-39 184.5v-3l173.2-100z" />
        <path class="iso-face iso-face--top" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m4.3 6.5 129.9 75-173.2 100-129.9-75z" />
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m-164.5 101 129.9 75v-3l-129.9-75z" />
        <path class="iso-face iso-face--right" stroke="var(--iso-stroke)" stroke-linejoin="round" d="M138.6 76-34.6 176v-3L138.6 73z" />
        <path class="iso-face iso-face--top" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m8.7-2 129.9 75-173.2 100-129.9-75z" />
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m-160.2 92.5 129.9 75v-3l-129.9-75z" />
        <path class="iso-face iso-face--right" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m142.9 67.5-173.2 100v-3l173.2-100z" />
        <path class="iso-face iso-face--top" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m13-10.5 129.9 75-173.2 100-129.9-75z" />
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="M-155.9 84-26 159v-3l-129.9-75z" />
        <path class="iso-face iso-face--right" stroke="var(--iso-stroke)" stroke-linejoin="round" d="M147.2 59-26 159v-3L147.2 56z" />
        <path class="iso-face iso-face--top" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m17.3-19 129.9 75L-26 156l-129.9-75z" />
      </g>

      <!-- tower (institutions & practice) -->
      <g class="iso-object" data-object="tower" tabindex="0" role="button" aria-label="Institutions" {...actionAttrs('tower')}>
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m69.3 168 95.2 55V113L69.3 58z" />
        <path class="iso-face iso-face--right" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m259.8 168-95.3 55V113l95.3-55z" />
        <path class="iso-face iso-face--top" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m164.5 3 95.3 55-95.3 55-95.2-55z" />
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m86.6 58 77.9 45V63L86.6 18z" />
        <path class="iso-face iso-face--accent" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m242.5 58-78 45V63l78-45z" />
        <path class="iso-face iso-face--top" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m164.5-27 78 45-78 45-77.9-45z" />
      </g>

      <!-- block (fieldwork / Shared Hope) -->
      <g class="iso-object" data-object="block" tabindex="0" role="button" aria-label="Fieldwork" {...actionAttrs('block')}>
        <path class="iso-face iso-face--left" stroke="var(--iso-stroke)" stroke-linejoin="round" d="M-95.3 263 0 318v-60l-95.3-55z" />
        <path class="iso-face iso-face--right" stroke="var(--iso-stroke)" stroke-linejoin="round" d="M103.9 258 0 318v-60l103.9-60z" />
        <path class="iso-face iso-face--top" stroke="var(--iso-stroke)" stroke-linejoin="round" d="m8.7 143 95.2 55L0 258l-95.3-55z" />
      </g>
    </svg>

    {platformObjects.map((obj) => (
      <div class="iso-tag" data-tag={obj.id} style={`left:${obj.pos[0]}; top:${obj.pos[1]}`}>
        <span class="iso-tag__pill">{obj.tag}</span>
        <span class="iso-tag__leader" aria-hidden="true"></span>
        <span class="iso-tag__dot" aria-hidden="true"></span>
      </div>
    ))}
  </div>

  <div class="platform__meta">
    <span class="mono" data-platform-counter>01 — 05</span>
    <span class="mono" data-platform-hint>Hover, or press ← → to explore</span>
  </div>
</div>

<style>
  .platform {
    position: relative;
    user-select: none;
  }
  .platform__scene {
    position: relative;
    width: 100%;
  }
  .platform__scene svg {
    width: 100%;
    display: block;
    overflow: visible;
  }
  .iso-object {
    cursor: pointer;
    outline: none;
    transition: transform 450ms var(--ease-reveal), opacity var(--dur-ui) var(--ease-reveal);
    transform-box: fill-box;
    transform-origin: center;
  }
  .iso-face--left { fill: var(--iso-left); }
  .iso-face--right { fill: url(#iso-stripe); }
  .iso-face--top { fill: var(--iso-top); }
  .iso-face--accent { fill: var(--accent); }

  /* dim non-active objects; the active one lifts and recolors */
  .platform[data-active] .iso-object { opacity: 0.45; }
  .platform[data-active] .iso-object[data-object='platform'] { opacity: 0.55; }
  .platform[data-active] .iso-object.is-active { opacity: 1; }
  .platform[data-active] .iso-object.is-active:not([data-object='platform']) {
    transform: translateY(-3%);
  }
  .platform[data-active] .iso-object.is-active .iso-face--left { fill: var(--iso-left-hi); }
  .platform[data-active] .iso-object.is-active .iso-face--top { fill: var(--iso-top-hi); }

  .iso-object.is-pulsing .iso-face--left,
  .iso-object.is-pulsing .iso-face--top {
    animation: iso-pulse 600ms var(--ease-reveal);
  }
  @keyframes iso-pulse {
    50% { filter: brightness(1.08); }
  }

  .iso-tag {
    position: absolute;
    transform: translate(-50%, -100%);
    pointer-events: none;
    opacity: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: opacity var(--dur-ui) var(--ease-reveal);
    z-index: 2;
  }
  .iso-tag.is-shown { opacity: 1; }
  .iso-tag.is-focused .iso-tag__pill {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .iso-tag__pill {
    background: var(--ink);
    color: var(--sand);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .iso-tag__leader { width: 1px; height: 28px; background: var(--ink); }
  .iso-tag__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ink); }

  .platform--touch .iso-tag { opacity: 0.7; }
  .platform--touch .iso-tag.is-shown { opacity: 1; }

  .platform__meta {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-sm);
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .iso-object { transition: opacity 200ms linear; }
    .platform[data-active] .iso-object.is-active:not([data-object='platform']) { transform: none; }
    .iso-object.is-pulsing .iso-face--left,
    .iso-object.is-pulsing .iso-face--top { animation: none; }
  }
</style>

<script>
  import { initPlatform, type PlatformController } from '../scripts/platform';

  declare global {
    interface HTMLElement {
      _platformController?: PlatformController;
    }
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-platform]').forEach((el) => {
      el._platformController?.destroy();
      el._platformController = initPlatform(el);
      el.dispatchEvent(new CustomEvent('platform:ready', { bubbles: true }));
    });
  }
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
