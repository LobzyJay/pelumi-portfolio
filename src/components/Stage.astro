---
// The Stage — homepage's central device. Server-renders the static Rooms
// (the no-JS / small-screen / reduced-motion truth); on qualifying viewports
// stage.ts upgrades this into a sticky, scroll-driven room with the shared
// Platform diagram on the left (Option 2 from the plan: the platform
// replaces the per-room drawings inside the enhanced view — the static
// fallback still shows them, since Atlas 03 is untouched).
import { getEntry } from 'astro:content';
import { rooms } from '../data/rooms';
import Rooms from './Rooms.astro';
import Platform from './Platform.astro';

const roomsData = await Promise.all(
  rooms.map(async (room) => {
    const docs = await Promise.all(room.docs.map((slug) => getEntry('work', slug)));
    return {
      id: room.id,
      number: room.number,
      label: room.label,
      title: room.title,
      meta: room.meta,
      focusAreas: room.focusAreas,
      bgVar: room.id === 'technology' ? '--room-sage' : room.id === 'people' ? '--room-clay' : '--room-sky',
      inkVar: room.id === 'technology' ? '--room-sage-ink' : room.id === 'people' ? '--room-clay-ink' : '--room-sky-ink',
      highlight: room.docs[room.docs.length - 1],
      docs: docs
        .filter((d): d is NonNullable<typeof d> => Boolean(d))
        .map((d) => ({
          slug: d.id,
          meta: `${d.data.dateLabel} · ${String(d.data.order).padStart(2, '0')} · ${d.data.format}`,
          title: d.data.title,
          body: d.data.excerpt,
        })),
    };
  }),
);
---

<div id="stage" data-stage>
  <div data-rooms-static>
    <Rooms />
  </div>

  <div data-stage-enhanced hidden>
    <div class="enhanced-room">
      <div class="enhanced-room__bar">
        <div class="mono enhanced-room__label">
          <span data-room-label>Room 01</span>
          <span class="enhanced-room__sep" aria-hidden="true"></span>
          <span class="enhanced-room__pips" data-room-pips>
            <span class="enhanced-room__pip is-active"></span>
            <span class="enhanced-room__pip"></span>
            <span class="enhanced-room__pip"></span>
          </span>
        </div>
        <div class="mono" data-room-meta>3 documents · 2025–2026</div>
      </div>

      <div class="enhanced-room__body grid-12">
        <div class="enhanced-room__platform col-span-5">
          <div data-room-textblock>
            <h2 class="enhanced-room__title" data-room-title>Technology &amp; governance</h2>
            <p class="enhanced-room__focus" data-room-focus>AI policy · AI governance &amp; responsible AI</p>
          </div>
          <Platform />
        </div>
        <div class="enhanced-room__docs col-span-7" data-room-docs></div>
      </div>

      <div class="enhanced-room__foot mono">
        <span data-room-progress>Room 01 of 03 · 0%</span>
        <span>Keep scrolling</span>
      </div>
    </div>
  </div>

  <script type="application/json" data-stage-data set:html={JSON.stringify(roomsData)} />
</div>

<style>
  #stage { position: relative; }

  [data-stage-enhanced] { height: 400vh; }
  .enhanced-room {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    box-sizing: border-box;
    padding: var(--space-md) var(--gutter) var(--space-lg);
    display: flex;
    flex-direction: column;
    transition: background var(--dur-reveal) var(--ease-reveal), color var(--dur-reveal) var(--ease-reveal);
  }
  .enhanced-room__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .enhanced-room__label { display: flex; align-items: center; gap: 12px; }
  .enhanced-room__sep { width: 1px; height: 12px; background: currentColor; opacity: 0.5; }
  .enhanced-room__pips { display: flex; gap: 6px; align-items: center; }
  .enhanced-room__pip {
    width: 6px; height: 6px; border-radius: 3px;
    background: currentColor; opacity: 0.35;
    transition: width 400ms var(--ease-reveal), opacity 400ms;
  }
  .enhanced-room__pip.is-active { width: 28px; opacity: 1; }

  .enhanced-room__body {
    flex: 1;
    column-gap: var(--space-xl);
    align-items: center;
    min-height: 0;
  }
  .enhanced-room__platform {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }
  [data-room-textblock] {
    transition: opacity 350ms var(--ease-reveal), transform 500ms var(--ease-reveal);
  }
  [data-room-textblock].is-swapping {
    opacity: 0;
    transform: translateY(16px);
  }
  .enhanced-room__title {
    font-size: var(--size-room-title);
    letter-spacing: -0.035em;
    line-height: 0.96;
  }
  .enhanced-room__focus {
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.4;
    opacity: 0.85;
    max-width: 40ch;
    margin-top: var(--space-sm);
  }
  .enhanced-room__docs {
    min-width: 0;
    transition: opacity 350ms var(--ease-reveal) 60ms, transform 500ms var(--ease-reveal) 60ms;
  }
  .enhanced-room__docs.is-swapping {
    opacity: 0;
    transform: translateY(24px);
    transition-delay: 0ms;
  }

  .enhanced-room__foot {
    display: flex;
    justify-content: space-between;
  }

  @media (max-width: 900px) {
    .enhanced-room__body { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initStage } from '../scripts/stage';
  initStage();
  document.addEventListener('astro:page-load', initStage);
</script>
