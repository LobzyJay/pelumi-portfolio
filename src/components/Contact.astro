---
// The closing card on every page: where to reach her, and the colophon.
// The arches pattern sits behind the content and fades out toward the bottom,
// so the footer row always lands on a solid ground.
import Icon from './Icon.astro';
import PatternField from './PatternField.astro';
import { site } from '../data/site';

// Résumé leads to its page; on the page itself it downloads the PDF instead of
// linking to where you already are.
const onResume = Astro.url.pathname.startsWith('/resume');
const resumeLink = onResume
  ? { href: site.contact.resumePdf, download: 'Igbalajobi-Oluwapelumi-Resume.pdf' }
  : { href: site.contact.resumePage };
const mailHref = `mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.emailSubject)}`;
---

<section class="pi-contact" id="contact" aria-labelledby="contact-title">
  <div class="pi-contact__card" data-morph-source>
    <PatternField variant="tile" />
    <div class="pi-contact__content">
      <p class="pi-contact__place pi-label pi-label--12" data-reveal>
        <Icon name="pin" size={16} />{site.city}
      </p>

      <div class="pi-contact__row">
        <h2 class="pi-contact__title" id="contact-title" data-reveal style="--reveal-delay:80ms">Recommendation: <br />get in touch.</h2>
        <div class="pi-contact__actions" data-reveal style="--reveal-delay:200ms">
          <a class="pi-btn pi-btn--pink" href={mailHref}><Icon name="mail" />Email</a>
          <a class="pi-btn pi-btn--outline" href={site.contact.linkedin} target="_blank" rel="noopener me">
            <Icon name="linkedin" />LinkedIn
          </a>
          <a class="pi-btn pi-btn--outline" {...resumeLink}>
            <Icon name="document" />Résumé
          </a>
        </div>
      </div>

      <div class="pi-contact__foot pi-label pi-label--12" data-reveal style="--reveal-delay:320ms">
        <span>{site.legalName}</span>
        <span>© {site.year} · {site.studio}</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* The same gap above the card as below it (and on phones too — the phone
     layout had none above). */
  .pi-contact {
    --gap-card: 43px;
    padding: var(--gap-card) var(--gutter);
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
  }
  .pi-contact__card {
    position: relative;
    overflow: hidden;
    border-radius: 40px;
    padding: 72px;
    background: var(--card);
    color: var(--ink);
    border: 1.5px solid var(--hair);
  }
  /* The design stacks a fade over the pattern: clear at the top, solid card by
     78%. Done as an overlay so the pattern layer itself can move. */
  .pi-contact__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(243, 220, 210, 0) 0%, var(--card) 78%);
  }
  .pi-contact__content { position: relative; z-index: 2; }
  .pi-contact__foot span { overflow-wrap: anywhere; }
  /* flex children default to min-width:auto, so one long word could widen the
     whole card; let them shrink instead */
  .pi-contact__row > * { min-width: 0; }

  .pi-contact__place {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
    margin: 0 0 24px;
    color: var(--pink-deep);
  }
  .pi-contact__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }
  .pi-contact__title {
    font-size: clamp(56px, 6vw, 86px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .pi-contact__actions { display: flex; gap: 10px; flex-wrap: nowrap; flex-shrink: 0; }
  .pi-contact__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    margin-top: 76px;
    padding-top: 16px;
    border-top: 1.5px dashed var(--hair);
    color: var(--pink-deep);
  }

  @media (max-width: 1023px) {
    .pi-contact { --gap-card: 16px; }
    .pi-contact__card { border-radius: 28px; padding: 36px 24px 24px; }
    .pi-contact__card > .pi-contact__content {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .pi-contact__place { justify-content: flex-start; margin: 0; font-size: 11px; }
    .pi-contact__row { flex-direction: column; align-items: stretch; gap: 28px; }
    .pi-contact__title { font-size: clamp(38px, 7vw, 64px); line-height: 1; letter-spacing: -0.04em; }
    .pi-contact__title br { display: none; }
    .pi-contact__actions { flex-direction: column; flex-shrink: 1; }
    .pi-contact__actions .pi-btn { width: 100%; }
    .pi-contact__foot {
      flex-direction: column;
      gap: 4px;
      margin-top: 0;
      padding-top: 14px;
      font-size: 11px;
    }
  }
</style>
