---
// Static rooms — the no-JS / small-screen / reduced-motion / print truth.
// This is what everyone gets before Stage.astro's enhancement script runs,
// and what stays for anyone who doesn't qualify for the sticky treatment.
// Source: Atlas 03 - The Rooms.dc.html.
import { getEntry } from 'astro:content';
import { rooms } from '../data/rooms';
import DocList from './DocList.astro';

// Inlined as raw markup, not <img src="data:...">: SVG data-URIs failed to
// decode (naturalWidth 0) across every browser tested during QA, so every
// isometric drawing on the site renders as real inline SVG instead.
const isoModules = import.meta.glob('../assets/iso/*-atlas.svg', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>;
const isoMarkup = (name: string) => {
  const match = Object.entries(isoModules).find(([path]) => path.endsWith(`${name}-atlas.svg`));
  return match?.[1] ?? '';
};

const roomsWithDocs = await Promise.all(
  rooms.map(async (room) => {
    const docs = await Promise.all(room.docs.map((slug) => getEntry('work', slug)));
    return { room, docs: docs.filter((d): d is NonNullable<typeof d> => Boolean(d)) };
  }),
);
---

<div class="rooms">
  {roomsWithDocs.map(({ room, docs }, i) => (
    <section
      class="room"
      class:list={[`room-${room.id === 'technology' ? 'sage' : room.id === 'people' ? 'clay' : 'sky'}`]}
      id={`room-${room.number}`}
    >
      <div class="room__inner grid-12" class:list={{ 'room__inner--flip': i % 2 === 1 }}>
        <div class="room__text col-span-5">
          <p class="mono" data-reveal data-reveal-group={`room-${i}`} data-reveal-order="0">{room.label}</p>
          <h2 class="room__title" data-reveal data-reveal-group={`room-${i}`} data-reveal-order="1">{room.title}</h2>
          <p class="room__focus" data-reveal data-reveal-group={`room-${i}`} data-reveal-order="2">
            {room.focusAreas.join(' · ')}
          </p>
          {isoMarkup(room.isoAsset) && (
            <span class="room__art" data-reveal data-reveal-group={`room-${i}`} data-reveal-order="3" set:html={isoMarkup(room.isoAsset)} />
          )}
        </div>
        <div class="room__list col-span-7">
          <DocList docs={docs} highlight={room.docs[room.docs.length - 1]} revealGroup={`room-${i}-list`} />
        </div>
      </div>
    </section>
  ))}
</div>

<style>
  .room {
    padding-block: var(--space-xl);
  }
  .room__inner {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    column-gap: var(--space-lg);
    align-items: center;
  }
  .room__inner--flip .room__text { order: 2; }
  .room__inner--flip .room__list { order: 1; }
  .room__title {
    font-size: var(--size-room-title);
    letter-spacing: -0.035em;
    line-height: 0.96;
    margin-top: var(--space-sm);
  }
  .room__focus {
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.5;
    margin-top: var(--space-sm);
    opacity: 0.85;
    max-width: 38ch;
  }
  .room__art {
    display: block;
    width: min(220px, 60%);
    margin-top: var(--space-lg);
  }
  .room__art :global(svg) { width: 100%; display: block; }
  @media (max-width: 640px) {
    .room__inner, .room__inner--flip {
      grid-template-columns: 1fr;
    }
    .room__inner--flip .room__text,
    .room__inner--flip .room__list,
    .room__text, .room__list { order: initial; }
    .room__list { margin-top: var(--space-lg); }
    .room__art { width: 40%; }
  }
</style>
