---
// The nine focus areas as one continuous line of type, each word taking a
// tone from the palette. The tone cycle is fixed (ink, mahogany, pink, coral,
// ink, …) so the rhythm never changes between builds.
//
// Pink words on cream use --pink-text, not brand pink: brand pink is 2.54:1
// on cream, below the 3:1 large-text floor (see theme.css).
import { focusAreasShort } from '../data/work';

const areas = focusAreasShort();
const count = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][areas.length];

// One tone per area, in the order the design sets them.
const tones = ['ink', 'mahogany', 'pink', 'coral', 'ink', 'mahogany', 'coral', 'pink', 'ink'];
---

<section class="focus pi-wrap">
  <div class="focus__head pi-label">
    <span>Focus areas</span>
    <span><span class="focus__count">{count}</span>, in three groups</span>
  </div>
  <h2 class="focus__run">
    {areas.map((area, i) => (
      <>
        <span class={`focus__area focus__area--${tones[i % tones.length]}`}>{area}</span>
        {/* Astro strips whitespace between adjacent elements, and with no
            space characters there is nowhere for the line to wrap. */}
        {i < areas.length - 1 && <>{' '}<span class="focus__sep" aria-hidden="true">/</span>{' '}</>}
      </>
    ))}
  </h2>
</section>

<style>
  .focus {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding-top: 56px;
    padding-bottom: 64px;
  }
  .focus__head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--plum);
    padding-bottom: 40px;
  }
  .focus__count { color: var(--ink); white-space: nowrap; }

  .focus__run {
    font-size: 60px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }
  .focus__area { white-space: nowrap; }
  .focus__area--ink { color: var(--ink); }
  .focus__area--mahogany { color: var(--mahogany); }
  .focus__area--pink { color: var(--pink-text); }
  .focus__area--coral { color: var(--coral); }
  .focus__sep { color: var(--pink); padding: 0 0.18em; }

  @media (max-width: 1279px) {
    .focus__run { font-size: clamp(32px, 4.6vw, 60px); }
  }
  @media (max-width: 1023px) {
    .focus { padding-top: 40px; padding-bottom: 48px; }
    .focus__head { padding-bottom: 20px; }
    .focus__head span:last-child { display: none; }
    .focus__run {
      font-size: 32px;
      line-height: 1.15;
      letter-spacing: -0.03em;
      display: flex;
      flex-wrap: wrap;
      gap: 4px 10px;
    }
    /* the phone artboard sets every word in ink; only the slashes carry colour */
    .focus__area { color: var(--ink); white-space: normal; }
    .focus__sep { padding: 0; font-weight: 700; }
  }
</style>
