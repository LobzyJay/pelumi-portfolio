---
// The nine focus areas as one continuous line of type, all in the dark ink
// colour. Only the slashes between them carry the pink. (The artboard tried
// each word in a different palette colour; one colour reads calmer and every
// word clears the contrast floor by a wide margin.)
import { focusAreasShort } from '../data/work';

const areas = focusAreasShort();
const count = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][areas.length];

---

<section class="focus pi-wrap">
  <div class="focus__head pi-label" data-reveal>
    <span>Focus areas</span>
    <span><span class="focus__count">{count}</span>, in three groups</span>
  </div>
  <h2 class="focus__run">
    {areas.map((area, i) => (
      <>
        <span class="focus__area">{area}</span>
        {/* Astro strips whitespace between adjacent elements, and with no
            space characters there is nowhere for the line to wrap. */}
        {i < areas.length - 1 && <>{' '}<span class="focus__sep" aria-hidden="true">/</span>{' '}</>}
      </>
    ))}
  </h2>
</section>

<style>
  .focus {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding-top: 56px;
    padding-bottom: 64px;
  }
  .focus__head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--plum);
    padding-bottom: 40px;
  }
  .focus__count { color: var(--ink); white-space: nowrap; }

  .focus__run {
    font-size: 60px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }
  .focus__area { white-space: nowrap; color: var(--ink); }

  /* Scroll-driven, LINE BY LINE: the whole line starts faint, and each line
     firms up to full ink as it rises through the viewport — first line, then
     the next a beat behind. Every word (and its slash) is tied to its own
     position on the page, and words on one line share a height, so a line
     moves as one without the script knowing where the lines break. It is tied
     to the scroll itself — stop scrolling and it stops — which is what makes it
     feel like reading down the page.
     Progressive enhancement: where scroll-driven animation isn't supported,
     none of this applies and the words are simply solid. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .focus__area,
      .focus__sep {
        display: inline-block; /* inline boxes can't be transformed */
        /* Longhands on purpose — see the note in Highlights.astro. */
        animation-name: focus-read;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 0% cover 16%;
      }
      @keyframes focus-read {
        from { opacity: 0.1; transform: translate3d(0, 0.4em, 0); }
        to { opacity: 1; transform: none; }
      }
    }
  }
  .focus__sep { color: var(--pink); padding: 0 0.18em; }

  @media (max-width: 1279px) {
    .focus__run { font-size: clamp(32px, 4.6vw, 60px); }
  }
  @media (max-width: 1023px) {
    .focus { padding-top: 40px; padding-bottom: 48px; }
    .focus__head { padding-bottom: 20px; }
    .focus__head span:last-child { display: none; }
    .focus__run {
      font-size: 32px;
      line-height: 1.15;
      letter-spacing: -0.03em;
      display: flex;
      flex-wrap: wrap;
      gap: 4px 10px;
    }
    .focus__area { white-space: normal; }
    .focus__sep { padding: 0; font-weight: 700; }
  }
</style>
