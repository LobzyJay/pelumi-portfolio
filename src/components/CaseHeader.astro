---
import type { CollectionEntry } from 'astro:content';
interface Props { doc: CollectionEntry<'work'> }
const { doc } = Astro.props;
const d = doc.data;
---

<header class="case-header">
  <div class="case-header__memo grid-12">
    <div class="col-span-6"><span class="mono">To</span><p>{d.addressee}</p></div>
    <div class="col-span-6"><span class="mono">From</span><p>Pelumi Igbalajobi{d.coauthors.length ? ` and ${d.coauthors.join(', ')}` : ''} — {d.authorRole}</p></div>
    <div class="col-span-6"><span class="mono">Subject</span><p>{d.title}</p></div>
    <div class="col-span-6"><span class="mono">Date</span><p>{d.dateLabel}</p></div>
  </div>
</header>

<style>
  .case-header__memo {
    row-gap: var(--space-md);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--rule);
  }
  .case-header__memo span {
    color: var(--ink-soft);
  }
  .case-header__memo p {
    margin-top: 6px;
    font-size: var(--size-small);
    line-height: 1.4;
  }
</style>
