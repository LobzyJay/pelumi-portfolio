---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeroShell from '../components/HeroShell.astro';
import FolioBand from '../components/FolioBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { timeline } from '../data/resume';
import portrait from '../assets/photos/hero-portrait.jpg';
import graduation from '../assets/photos/graduation-ut-tower.jpg';
import studio from '../assets/photos/studio-portrait-wide.jpg';
---

<Layout
  title="About"
  description={`${site.name} is a global policy analyst in Washington, D.C. with a Master of Global Policy from the LBJ School, UT Austin, and experience in anti-trafficking, advocacy and development work.`}
>
  <HeroShell size="page" top={112} bottom={56}>
    <div class="intro">
      <div class="intro__top pi-label pi-label--12">
        <span class="intro__kicker pi-enter">About · Global policy analyst · {site.city}</span>
        <span class="intro__kicker-m">About</span>
        <span class="intro__city">{site.city}</span>
      </div>
      <div class="intro__portrait pi-enter" style="--enter-delay:1000ms">
        <Image class="intro__photo" src={portrait} width={440} alt={site.name} loading="eager" />
      </div>
      <div class="intro__bottom">
        <h1 class="intro__line pi-enter" style="--enter-delay:950ms">{site.shyLine}</h1>
        <div class="intro__who pi-enter" style="--enter-delay:1200ms">
          <span>{site.legalName}</span>
          <span class="intro__degree">Master of Global Policy, UT Austin</span>
        </div>
      </div>
    </div>
  </HeroShell>

  <section class="about pi-wrap">
    <h2 class="about__lead" data-reveal>{site.positioning}</h2>

    <div class="block" data-reveal>
      <span class="pi-label pi-label--12 pi-eyebrow">01 Background</span>
      <p class="about__bio pi-body">{site.backgroundShort}</p>
      <p class="about__note pi-body">{site.backgroundNote}</p>
    </div>

    <div class="block">
      <span class="pi-label pi-label--12 pi-eyebrow">02 Education &amp; experience</span>
      <ol class="timeline">
        {timeline.map((t, i) => (
          <li class="tl" data-reveal style={`--reveal-delay:${Math.min(i, 5) * 60}ms`}>
            <span class="tl__date pi-label">{t.dates}</span>
            <div class="tl__body">
              <h3 class="tl__title">{t.title}</h3>
              <p class="tl__detail pi-body">{t.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FolioBand class="places">
    <div class="places__inner">
      <div class="card card--wide" data-reveal>
        <span class="card__k pi-label pi-label--12">Places</span>
        <ul class="slashes">
          {site.places.map((p, i) => (
            <>
              {i > 0 && <li class="slashes__sep" aria-hidden="true">/</li>}
              <li>{p}</li>
            </>
          ))}
        </ul>
      </div>
      <div class="card" data-reveal style="--reveal-delay:90ms">
        <span class="card__k pi-label pi-label--12">Interests</span>
        <span class="card__v pi-body">{site.interests}</span>
      </div>
      <div class="card" data-reveal style="--reveal-delay:180ms">
        <span class="card__k pi-label pi-label--12">Off the clock</span>
        <span class="card__v pi-body">{site.offTheClock}</span>
      </div>
    </div>
  </FolioBand>

  <section class="frame pi-wrap">
    <span class="pi-label pi-label--12 pi-eyebrow">03 In frame</span>
    <div class="frame__grid">
      <figure class="frame__a" data-reveal>
        <Image class="frame__img" src={graduation} width={1400} alt={`${site.firstName} at graduation, in front of the UT Austin tower`} />
      </figure>
      <figure class="frame__b" data-reveal style="--reveal-delay:120ms">
        <Image class="frame__img" src={studio} width={900} alt={`${site.firstName}, studio portrait, wider crop`} />
      </figure>
    </div>
    <div class="frame__cta" data-reveal>
      <span class="pi-label">Full CV, education and selected work</span>
      <a class="pi-btn pi-btn--ink" href="/resume/">Résumé<Icon name="arrow-right" /></a>
    </div>
  </section>
</Layout>

<style>
  /* ---- hero card ---- */
  .intro {
    flex: 1;
    position: relative;
    background: var(--ink);
    color: var(--cream);
    border-radius: 20px;
    padding: 48px 56px 52px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  .intro__top { color: var(--pink); padding-right: 260px; }
  .intro__kicker-m, .intro__city { display: none; }
  /* The ring and the clip belong to the frame; the photo inside it is free to
     zoom on hover without ever growing past the ring. */
  .intro__portrait {
    position: absolute;
    top: 48px;
    right: 56px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 6px var(--pink);
  }
  .intro__portrait :global(.intro__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    transition: transform 900ms var(--ease-out);
  }
  .intro__bottom { display: flex; flex-direction: column; gap: 28px; }
  .intro__line {
    font-size: clamp(56px, 5.8vw, 84px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    max-width: 14ch;
    text-wrap: balance;
  }
  .intro__who {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 22px;
    border-top: 1.5px dashed rgba(251, 168, 238, 0.5);
    font-size: 19px;
  }
  .intro__degree { color: var(--pink-soft); }

  /* ---- body ---- */
  .about {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding-block: 64px 0;
  }
  .about__lead {
    font-size: 56px;
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
    max-width: 26ch;
    text-wrap: balance;
  }
  .block { margin-top: 64px; }
  .about__bio { font-size: 24px; line-height: 1.5; max-width: 58ch; }
  .about__note {
    margin-top: 16px;
    opacity: 0.55;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 1.7;
  }

  .timeline { border-top: 1.5px solid var(--ink); }
  .tl {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1.5px dashed var(--hair);
  }
  .tl__date { grid-column: span 3; }
  .tl__body { grid-column: span 9; }
  .tl__title { font-size: 24px; font-weight: 400; line-height: 1.15; letter-spacing: -0.025em; }
  .tl__detail { font-size: 16px; line-height: 1.5; margin-top: 8px; max-width: 60ch; color: var(--plum); }

  /* ---- places / interests on the folio band ---- */
  :global(.places) { margin-top: 64px; }
  .places__inner {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding: 96px var(--gutter);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .card {
    background: var(--cream);
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card--wide { grid-column: 1 / span 2; gap: 16px; }
  .card__k { color: var(--plum); }
  .card__v { font-size: 20px; line-height: 1.45; }
  .slashes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    font-size: 40px;
    letter-spacing: -0.025em;
  }
  .slashes__sep { color: var(--pink); font-weight: 700; }

  /* ---- in frame ---- */
  .frame {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding-block: 64px;
  }
  .frame__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 24px;
    align-items: start;
  }
  .frame__a, .frame__b {
    width: 100%;
    border-radius: 20px;
    overflow: hidden; /* the image zooms inside this frame on hover */
  }
  .frame__a { grid-column: span 7; aspect-ratio: 4 / 3; }
  .frame__b { grid-column: span 5; aspect-ratio: 4 / 5; }
  .frame :global(.frame__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  .frame__a :global(.frame__img) { object-position: 50% 30%; }
  /* Pictures answer the mouse with a slow, small push-in. Fine pointers only
     (a tap would leave it stuck), and never under reduced motion. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .intro__portrait:hover :global(.intro__photo) { transform: scale(1.07); }
    .frame__a:hover :global(.frame__img),
    .frame__b:hover :global(.frame__img) { transform: scale(1.04); }
  }
  .frame__cta {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1.5px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* ---- phone / tablet ---- */
  @media (max-width: 1023px) {
    .intro { border-radius: 18px; padding: 28px 24px; gap: 24px; flex: none; }
    .intro__top { padding-right: 0; display: flex; justify-content: space-between; gap: 12px; font-size: 11px; }
    .intro__kicker { display: none; }
    .intro__kicker-m { display: inline; }
    .intro__city { display: inline; color: var(--pink-soft); }
    .intro__portrait {
      position: static;
      align-self: center;
      width: 200px;
      height: 200px;
      margin-block: 8px;
      box-shadow: 0 0 0 5px var(--pink);
    }
    .intro__bottom { gap: 24px; }
    .intro__line { font-size: clamp(44px, 9vw, 72px); max-width: none; }
    .intro__who { padding-top: 16px; gap: 4px; font-size: 16px; }

    .about { padding-block: 40px 0; display: flex; flex-direction: column; gap: 48px; }
    .about__lead { font-size: clamp(30px, 6vw, 44px); line-height: 1.12; letter-spacing: -0.03em; }
    .block { margin-top: 0; }
    .about__bio { font-size: 18px; }
    .tl { display: flex; flex-direction: column; gap: 6px; padding: 18px 0; }
    .tl__title { font-size: 20px; line-height: 1.2; letter-spacing: -0.02em; }
    .tl__detail { font-size: 15px; margin-top: 0; }

    :global(.places) { margin-top: 48px; }
    .places__inner { padding: 40px var(--gutter); grid-template-columns: 1fr; gap: 12px; }
    .card--wide { grid-column: auto; }
    .card { padding: 24px; border-radius: 16px; gap: 10px; }
    .card__v { font-size: 17px; line-height: 1.45; }
    .slashes { font-size: 26px; gap: 6px 12px; }

    .frame { padding-block: 40px; display: flex; flex-direction: column; gap: 12px; }
    .frame__grid { display: flex; flex-direction: column; gap: 12px; }
    .frame__a, .frame__b { border-radius: 18px; }
    .frame__cta { flex-direction: column; align-items: stretch; gap: 14px; margin-top: 20px; padding-top: 0; border-top: 0; }
    .frame__cta .pi-label { display: none; }
  }
</style>
