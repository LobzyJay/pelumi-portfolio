---
// A missing URL still lands somewhere that looks like the site. noindex: an
// error page has no business in search results.
import Layout from '../layouts/Layout.astro';
import HeroShell from '../components/HeroShell.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Layout
  title="Page not found"
  description={`That page does not exist — ${site.name}, global policy analyst.`}
  noindex
>
  <HeroShell size="page" top={108} bottom={48}>
    <div class="nf" data-morph-source>
      <span class="nf__k pi-label pi-label--12">Page not found</span>
      <h1 class="nf__code pi-enter">404</h1>
      <div class="nf__foot pi-enter" style="--enter-delay:1150ms">
        <p class="nf__line">{site.notFoundLine}</p>
        <div class="nf__actions">
          <a class="pi-btn pi-btn--pink" href="/">Home<Icon name="arrow-right" /></a>
          <a class="pi-btn pi-btn--outline" href="/work/">Work</a>
          <a class="pi-btn pi-btn--outline" href="/about/">About</a>
        </div>
      </div>
    </div>
  </HeroShell>
</Layout>

<style>
  .nf {
    background: var(--card);
    color: var(--ink);
    border: 1.5px solid var(--hair);
    border-radius: 32px;
    padding: var(--card-y) var(--card-x);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  .nf__k { color: var(--pink-deep); }
  .nf__code {
    font-size: clamp(160px, 26vw, 380px);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.05em;
  }
  /* Same 7 / 5 split as the home hero's pitch and actions. */
  .nf__foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: end;
  }
  .nf__line { grid-column: 1 / span 7; font-size: 32px; line-height: 1.2; letter-spacing: -0.015em; }
  .nf__actions { grid-column: 8 / span 5; display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }

  @media (max-width: 1023px) {
    .nf { border-radius: 24px; min-height: 480px; }
    .nf__foot { display: flex; flex-direction: column; gap: 20px; align-items: stretch; }
    .nf__line { font-size: 22px; }
    .nf__actions { width: 100%; flex-direction: column; }
    .nf__actions .pi-btn { width: 100%; }
  }
</style>
