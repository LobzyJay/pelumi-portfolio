---
// A missing URL still lands somewhere that looks like the site. noindex: an
// error page has no business in search results.
import Layout from '../layouts/Layout.astro';
import HeroShell from '../components/HeroShell.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Layout
  title="Page not found"
  description={`That page does not exist — ${site.name}, global policy analyst.`}
  noindex
>
  <HeroShell size="page" top={108} bottom={48}>
    <div class="nf">
      <span class="nf__k pi-label pi-label--12">Page not found</span>
      <h1 class="nf__code">404</h1>
      <div class="nf__foot">
        <p class="nf__line">{site.notFoundLine}</p>
        <div class="nf__actions">
          <a class="pi-btn pi-btn--pink" href="/">Home<Icon name="arrow-right" tone="ink" /></a>
          <a class="pi-btn pi-btn--outline" href="/work/">Work</a>
          <a class="pi-btn pi-btn--outline" href="/about/">About</a>
        </div>
      </div>
    </div>
  </HeroShell>
</Layout>

<style>
  .nf {
    flex: 1;
    background: var(--ink);
    color: var(--cream);
    border-radius: 32px;
    padding: 48px 56px 52px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  .nf__k { color: var(--pink); }
  .nf__code {
    font-size: clamp(160px, 26vw, 380px);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.05em;
  }
  .nf__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 28px;
    border-top: 1.5px dashed rgba(251, 168, 238, 0.5);
  }
  .nf__line { font-size: 32px; line-height: 1.2; letter-spacing: -0.015em; }
  .nf__actions { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 1023px) {
    .nf { border-radius: 24px; padding: 28px 24px; min-height: 480px; }
    .nf__line { font-size: 22px; }
    .nf__actions { width: 100%; flex-direction: column; }
    .nf__actions .pi-btn { width: 100%; }
  }
</style>
