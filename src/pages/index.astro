---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hall from '../components/Hall.astro';
import Stage from '../components/Stage.astro';
import ContactRoom from '../components/ContactRoom.astro';
---

<Base
  title="Home"
  description="Pelumi Igbalajobi is a global-policy analyst working at the intersection of emerging technology, human security and governance."
>
  <a class="marking-line no-print" href="/work">PUBLIC · SELECTED WORK 2025–2026</a>
  <Nav />
  <main id="main">
    <Hall />
    <Stage />
  </main>
  <ContactRoom />
</Base>

<style>
  .marking-line {
    display: block;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    padding: 6px;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
  }
</style>
