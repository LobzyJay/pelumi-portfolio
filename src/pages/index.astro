---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Proof from '../components/Proof.astro';
import Focus from '../components/Focus.astro';
import Highlights from '../components/Highlights.astro';
import Field from '../components/Field.astro';

const docs = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="The Signal"
  description="Alternative homepage direction — Pelumi Igbalajobi, global policy analyst."
>
  <Hero />
  <Proof />
  <Focus />
  <Highlights docs={docs} id="work" />
  <Field />
</Layout>
