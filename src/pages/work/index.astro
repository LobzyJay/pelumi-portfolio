---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Filters from '../../components/Filters.astro';
import FolderCard from '../../components/FolderCard.astro';

const docs = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const focusAreas = [...new Set(docs.flatMap((d) => d.data.focusAreas))].sort();
const formats = [...new Set(docs.map((d) => d.data.format))];
const years = [...new Set(docs.map((d) => d.data.date.getFullYear()))].sort();
---

<Base title="Selected work" description="Six documents spanning AI governance, trafficking prevention, national development and legislative affairs.">
  <Nav />
  <main id="main" class="wrap work-index">
    <div class="work-index__head">
      <h1>Selected work</h1>
      <p class="mono">Six · 2025–2026 · Academic exercises unless marked</p>
    </div>
    <Filters focusAreas={focusAreas} formats={formats} years={years} />
    <div class="work-index__grid grid-12">
      {docs.map((doc, i) => <FolderCard doc={doc} index={i} />)}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .work-index { padding-block: var(--space-xl) var(--space-3xl); }
  .work-index__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-lg);
  }
  .work-index__head h1 { font-size: var(--size-h2); letter-spacing: -0.03em; }
  .work-index__head p { color: var(--ink-soft); }
  .work-index__grid { row-gap: var(--space-md); }
  @media (max-width: 900px) {
    .work-index__grid > :global(.col-span-4) { grid-column: span 6; }
  }
</style>
