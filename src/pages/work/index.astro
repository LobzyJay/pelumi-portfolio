---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeroShell from '../../components/HeroShell.astro';
import WorkRow from '../../components/WorkRow.astro';
import { themes, themeNumbers } from '../../data/work';

const docs = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const lede =
  'Decision memos, an advisory to the UN, a research paper, a national development plan and a field report. Academic policy exercises unless marked.';
const rows = themes.map((t) => ({ id: t.id, title: t.title, numbers: themeNumbers(t, docs) }));
---

<Layout
  title="Work"
  description="Six pieces of policy writing: decision memos, an advisory to the UN, a research paper, a national development plan and a field report. Academic exercises unless marked."
>
  <HeroShell size="page" top={108} bottom={48}>
    <div class="wk" data-morph-source>
      <div class="wk__top pi-label pi-enter">
        <span>Selected writing</span>
      </div>

      <h1 class="wk__word pi-enter">Work</h1>

      <div class="wk__side pi-enter" style="--enter-delay:1150ms">
        <p class="wk__lede pi-body">{lede}</p>
        <!-- desktop: themes live inside the card -->
        <ul class="wk__themes">
          {rows.map((r) => (
            <li>
              <a class="theme" href="#list" data-theme-link={r.id}>
                <span>{r.title}</span><span class="theme__n">{r.numbers}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </HeroShell>

  <!-- phone: themes become a "browse" list under the hero -->
  <nav class="browse pi-wrap" aria-label="Browse by theme">
    <span class="browse__label pi-label">Browse by theme</span>
    {rows.map((r) => (
      <a class="browse__row" href="#list" data-theme-link={r.id}>
        <span>{r.title}</span><span class="browse__n pi-label">{r.numbers}</span>
      </a>
    ))}
  </nav>

  <section class="list pi-wrap" id="list">
    <div class="list__rows">
      {docs.map((doc, i) => (
        <div data-reveal style={`--reveal-delay:${Math.min(i, 5) * 60}ms`}><WorkRow doc={doc} /></div>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* ---- hero card ---- */
  .wk {
    flex: 1;
    background: var(--card);
    color: var(--ink);
    border: 1.5px solid var(--hair);
    border-radius: 32px;
    padding: var(--card-y) var(--card-x);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: end;
  }
  .wk__top { display: none; }
  .wk__word {
    grid-column: span 7;
    font-size: clamp(160px, 20.8vw, 300px);
    font-weight: 400;
    line-height: 0.78;
    letter-spacing: -0.05em;
  }
  .wk__side { grid-column: 8 / span 5; display: flex; flex-direction: column; gap: 24px; }
  .wk__lede { font-size: 20px; line-height: 1.45; text-wrap: pretty; }
  .wk__themes { display: flex; flex-direction: column; }
  .theme {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-top: 1.5px dashed var(--hair);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.4;
    transition: background-color var(--dur) var(--ease);
  }
  .theme__n { color: var(--pink-deep); }
  @media (hover: hover) and (pointer: fine) {
    .theme:hover { background: rgba(244, 107, 200, 0.12); }
  }
  .theme:active { background: rgba(244, 107, 200, 0.2); }

  .browse { display: none; }

  /* ---- list ---- */
  .list {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding-block: 64px;
  }
  .list__rows { border-top: 1.5px solid var(--ink); }

  /* ---- phone ---- */
  @media (max-width: 1023px) {
    .wk {
      flex: none;
      border-radius: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 20px;
      align-items: stretch;
    }
    .wk__top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      color: var(--pink-deep);
    }
    .wk__word {
      font-size: clamp(90px, 26vw, 160px);
      letter-spacing: -0.055em;
      margin-left: -6px;
      order: 2;
    }
    .wk__side { order: 3; gap: 16px; }
    .wk__lede {
      font-size: 16px;
      line-height: 1.5;
    }
    .wk__themes { display: none; }

    .browse { display: flex; flex-direction: column; padding-top: 24px; }
    .browse__label { color: var(--plum); padding-bottom: 10px; }
    .browse__row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      min-height: 48px;
      border-top: 1.5px dashed var(--hair);
      font-family: var(--font-body);
      font-size: 16px;
      transition: background-color var(--dur) var(--ease);
    }
    .browse__row:first-of-type { border-top: 1.5px solid var(--ink); }
    /* rust, not coral: coral is 3.19:1 on cream — fine for big numerals,
       not for 11px text */
    .browse__n { color: var(--rust); }
    .browse__row:active { background: rgba(244, 107, 200, 0.16); }

    .list { padding-top: 16px; padding-bottom: 40px; }
  }
</style>

<script>
  import { initThemes } from '../../scripts/themes';
  initThemes();
</script>
