---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeroShell from '../../components/HeroShell.astro';
import FolioBand from '../../components/FolioBand.astro';
import DocPreview from '../../components/DocPreview.astro';
import Icon from '../../components/Icon.astro';
import { formatIcon, pad, themesOf } from '../../data/work';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const docs = await getCollection('work');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const d = doc.data;

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const total = all.length;
const i = all.findIndex((x) => x.id === doc.id);
// Prev/next wrap around 01–06.
const prev = all[(i - 1 + total) % total];
const next = all[(i + 1) % total];
// Related = same theme (the groups on the Work page), nearest first. Matching
// on focus-area overlap missed pairs the design groups together.
const mine = themesOf(doc.id);
const related = all
  .filter((x) => x.id !== doc.id && themesOf(x.id).some((t) => mine.includes(t)))
  .slice(0, 2);

const formatLine = d.options ? `${d.format}, ${['zero', 'one', 'two', 'three', 'four'][d.options.length]} options` : d.format;
const length = d.pages && d.words ? `${d.pages} pages · ${d.words.toLocaleString('en-US')} words` : null;
const eyebrow = `${pad(d.order)} · ${d.format} · ${d.dateLabel}`;
---

<Layout title={d.title} description={d.question}>
  <HeroShell size="page" top={112} bottom={48}>
    <div class="memo" data-morph-source>
      <span class="memo__eyebrow pi-label pi-label--12 pi-enter">
        <Icon name={formatIcon[d.format]} size={18} />{eyebrow}
      </span>
      <h1 class="memo__question pi-enter" style="--enter-delay:950ms">{d.question}</h1>
      <div class="memo__route pi-enter" style="--enter-delay:1150ms">
        <span><Icon name="institution" />{d.addressee}</span>
        <span class="memo__slash" aria-hidden="true">/</span>
        <span><Icon name="document" />{d.authorRole}</span>
      </div>
    </div>

    {d.label === 'academic' && (
      <div class="note">
        <span class="note__text">{site.honestyLabel}</span>
        <span class="note__chip">Academic</span>
      </div>
    )}
  </HeroShell>

  <article class="case pi-wrap">
    <div class="case__grid">
      <aside class="facts">
        <div class="fact fact--title">
          <span class="pi-label fact__k">Title</span>
          <span class="fact__v pi-body">{d.title}</span>
        </div>
        <div class="fact">
          <span class="pi-label fact__k">Format</span>
          <span class="fact__v pi-body">{formatLine}</span>
        </div>
        <div class="fact">
          <span class="pi-label fact__k">Date</span>
          <span class="fact__v pi-body">{d.dateLabel}</span>
        </div>
        {length && (
          <div class="fact">
            <span class="pi-label fact__k">Length</span>
            <span class="fact__v pi-body">{length}</span>
          </div>
        )}
        <div class="fact fact--focus">
          <span class="pi-label fact__k">Focus areas</span>
          <ul class="chips">
            {d.focusAreas.map((fa) => <li class="pi-body">{fa}</li>)}
          </ul>
          <span class="fact__v fact__v--inline pi-body">{d.focusAreas.join(' · ')}</span>
        </div>
      </aside>

      <div class="body">
        <section>
          <span class="pi-label pi-label--12 pi-eyebrow">Recommendation</span>
          <p class="rec">{d.recommendation}</p>
        </section>

        <section class="gap">
          <span class="pi-label pi-label--12 pi-eyebrow">Context</span>
          <div class="prose pi-body"><Content /></div>
        </section>

        {d.options && (
          <section class="gap">
            <span class="pi-label pi-label--12 pi-eyebrow">Options considered</span>
            <div class="options">
              {d.options.map((o) => (
                <div class:list={['option', { 'option--chosen': o.verdict === 'chosen' }]}>
                  {o.verdict === 'chosen' && <span class="option__tag pi-label">Recommended</span>}
                  <h3 class="option__title">{o.title}</h3>
                  <p class="option__body pi-body">{o.summary}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {d.shows.length > 0 && (
          <section class="gap">
            <span class="pi-label pi-label--12 pi-eyebrow shows__eyebrow">What this shows</span>
            <FolioBand radius={20} class="shows">
              <div class="shows__panel">
                <span class="pi-label pi-label--12 shows__label">What this shows</span>
                <ul class="shows__list">
                  {d.shows.map((s) => (
                    <li class="shows__item"><span class="shows__mark" aria-hidden="true">§</span>{s}</li>
                  ))}
                </ul>
              </div>
            </FolioBand>
          </section>
        )}

        <section class="gap"><DocPreview doc={doc} /></section>

        {related.length > 0 && (
          <section class="gap">
            <span class="pi-label pi-label--12 pi-eyebrow">Related</span>
            <div class="related">
              {related.map((r) => (
                <a class="rel" href={`/work/${r.id}/`}>
                  <span class="rel__k pi-label">{pad(r.data.order)} · {r.data.format}</span>
                  <span class="rel__t">{r.data.title}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>

    <nav class="pager" aria-label="More work">
      <a class="pager__a" href={`/work/${prev.id}/`}>
        <span class="pager__k pi-label">← {pad(prev.data.order)} — {pad(total)}</span>
        <span class="pager__t">{prev.data.title}</span>
      </a>
      <a class="pager__a pager__a--next" href={`/work/${next.id}/`}>
        <span class="pager__k pi-label">{pad(next.data.order)} — {pad(total)} →</span>
        <span class="pager__t">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Layout>

<style>
  /* ---- hero ---- */
  .memo {
    flex: 1;
    background: var(--card);
    color: var(--ink);
    border: 1.5px solid var(--hair);
    border-radius: 20px;
    padding: var(--card-y) var(--card-x);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    text-align: center;
  }
  .memo__eyebrow { display: flex; align-items: center; gap: 8px; color: var(--pink-deep); }
  .memo__question {
    font-size: clamp(48px, 5.6vw, 80px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    max-width: 16ch;
    text-wrap: balance;
  }
  .memo__route {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
    font-family: var(--font-body);
    font-size: 20px;
  }
  .memo__route span { display: flex; align-items: center; gap: 8px; }
  .memo__slash { color: var(--pink-deep); font-weight: 700; }

  .note {
    margin-top: 16px;
    background: var(--cream);
    border: 1.5px solid var(--hair);
    border-radius: 14px;
    padding: 16px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .note__text { font-family: var(--font-body); font-size: 15px; line-height: 1.4; }
  .note__chip {
    flex-shrink: 0;
    background: var(--tint-coral);
    color: var(--rust);
    border-radius: 8px;
    padding: 8px 14px;
    font-family: var(--font-body);
    font-size: 15px;
  }

  /* ---- article ---- */
  .case {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding-block: 64px;
  }
  .case__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: start;
  }

  .facts {
    grid-column: span 3;
    position: sticky;
    top: 104px;
    display: flex;
    flex-direction: column;
  }
  .fact {
    padding: 16px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fact + .fact { border-top: 1.5px dashed var(--hair); }
  .fact__k { color: var(--plum); }
  .fact__v { font-size: 16px; line-height: 1.4; }
  .fact__v--inline { display: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .chips li {
    border: 1.5px solid var(--hair-strong);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 14px;
  }

  .body { grid-column: 5 / span 8; min-width: 0; }
  .gap { margin-top: 64px; }
  .rec {
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .prose { font-size: 20px; line-height: 1.5; letter-spacing: -0.005em; max-width: 62ch; }
  .prose :global(p + p) { margin-top: 1em; }

  .options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .option {
    border: 1.5px solid var(--hair-strong);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .option--chosen { border-color: var(--ink); background: var(--ink); color: var(--cream); }
  .option__tag { color: var(--pink); }
  .option__title { font-size: 22px; font-weight: 400; line-height: 1.15; letter-spacing: -0.025em; }
  .option__body { font-size: 15px; line-height: 1.5; }

  /* "What this shows": a labelled list on phones, a folio panel on desktop */
  .shows__eyebrow { display: none; }
  .shows__panel { padding: 32px; display: flex; flex-direction: column; gap: 12px; }
  .shows__label { margin-bottom: 6px; }
  .shows__list { display: flex; flex-direction: column; gap: 12px; }
  .shows__item {
    background: var(--cream);
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 19px;
  }
  .shows__mark {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 13px;
    color: var(--pink-deep);
  }

  /* related */
  .related { border-top: 1.5px dashed var(--hair); }
  .rel {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1.5px dashed var(--hair);
    transition: border-color var(--dur) var(--ease), background-color var(--dur-press) var(--ease), transform var(--dur-press) var(--ease);
  }
  .rel__k { grid-column: span 3; }
  .rel__t { grid-column: span 9; font-size: 24px; line-height: 1.15; letter-spacing: -0.025em; }
  @media (hover: hover) and (pointer: fine) {
    .rel:hover { border-bottom-color: var(--ink); }
  }
  .rel:active { transform: scale(0.98); background: var(--press-cream); }

  /* prev / next */
  .pager {
    margin-top: 96px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    row-gap: 12px;
  }
  .pager__a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--ink);
    color: var(--cream);
    border-radius: 20px;
    padding: 20px 26px;
    transition: background-color var(--dur-press) var(--ease), transform var(--dur-press) var(--ease);
  }
  .pager__a--next { align-items: flex-end; text-align: right; }
  .pager__k { opacity: 0.75; }
  .pager__t { font-weight: 500; font-size: 18px; line-height: 1.25; letter-spacing: -0.01em; }
  @media (hover: hover) and (pointer: fine) {
    .pager__a:hover { background: var(--plum); }
  }
  .pager__a:active { transform: scale(0.98); background: var(--press-ink); }

  /* ---- phone / tablet ---- */
  @media (max-width: 1023px) {
    .memo { border-radius: 18px; align-items: stretch; text-align: left; gap: 20px; justify-content: flex-start; flex: none; }
    .memo__eyebrow { font-size: 11px; }
    .memo__question { font-size: clamp(38px, 8.6vw, 64px); line-height: 1.02; letter-spacing: -0.035em; max-width: none; }
    .memo__route {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 8px;
      font-size: 15px;
    }
    /* needs the parent in the selector to beat `.memo__route span` */
    .memo__route .memo__slash { display: none; }
    .note {
      margin-top: 12px;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 14px 18px;
    }
    .note__text { font-size: 13px; line-height: 1.5; }
    .note__chip { font-size: 13px; font-weight: 500; border-radius: 6px; padding: 4px 10px; background: rgba(233, 96, 63, 0.12); }

    .case { padding-block: 32px 40px; }
    .case__grid { display: flex; flex-direction: column; }
    /* the sticky column becomes a 2-up fact strip */
    .facts {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      border-top: 1.5px solid var(--ink);
      padding-top: 16px;
    }
    .fact { padding: 0; gap: 4px; }
    .fact + .fact { border-top: 0; }
    .fact--title { display: none; }
    .fact__v { font-size: 15px; }
    .fact--focus .chips { display: none; }
    .fact__v--inline { display: block; }
    .fact--focus { grid-column: 1 / -1; }

    .gap { margin-top: 40px; }
    .body { margin-top: 32px; }
    .rec { font-size: 24px; line-height: 1.25; letter-spacing: -0.02em; }
    .prose { font-size: 17px; }
    .pi-eyebrow { margin-bottom: 12px; }

    .options { grid-template-columns: 1fr; gap: 10px; }
    .option { padding: 20px; border-radius: 16px; border-color: rgba(43, 21, 23, 0.2); gap: 10px; }
    .option--chosen { border-color: var(--ink); }
    .option__tag {
      align-self: flex-start;
      background: var(--pink);
      color: var(--ink);
      padding: 4px 10px;
      border-radius: 999px;
    }
    .option__title { font-size: 20px; line-height: 1.2; letter-spacing: -0.02em; }
    .option__body { color: var(--plum); }
    .option--chosen .option__body { color: var(--pink-soft); }

    .shows__eyebrow { display: block; }
    .shows__label { display: none; }
    /* `.shows` lands on FolioBand's root, which this page's scoped CSS can't
       reach — hence :global. On phones the panel drops its folio ground. */
    :global(.shows) { border-radius: 0 !important; background: none !important; }
    :global(.shows .folio__ground) { display: none; }
    .shows__panel { padding: 0; gap: 0; border-top: 1.5px solid var(--ink); }
    .shows__list { gap: 0; }
    .shows__item {
      background: none;
      border-radius: 0;
      padding: 12px 0;
      border-bottom: 1.5px dashed var(--hair);
      gap: 12px;
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.4;
      align-items: flex-start;
    }
    .shows__mark { color: var(--coral); font-size: inherit; }

    .related { display: flex; flex-direction: column; gap: 10px; border-top: 0; }
    .rel {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 18px;
      border: 1.5px solid rgba(43, 21, 23, 0.2);
      border-radius: 16px;
    }
    .rel__k { color: var(--rust); }
    .rel__t { font-size: 19px; line-height: 1.2; letter-spacing: -0.015em; }
    @media (hover: hover) and (pointer: fine) {
      .rel:hover { border-color: var(--ink); }
    }

    .pager {
      margin-top: 40px;
      gap: 10px;
      border-top: 1.5px solid var(--ink);
      padding-top: 16px;
    }
    .pager__a { background: none; color: var(--ink); padding: 0; border-radius: 0; }
    .pager__k { opacity: 1; }
    .pager__t { font-family: var(--font-body); font-weight: 400; font-size: 14px; line-height: 1.4; color: var(--plum); letter-spacing: 0; }
    .pager__a:active { background: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rel:active, .pager__a:active { transform: none; }
  }
</style>
