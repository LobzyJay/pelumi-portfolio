---
import { getCollection } from 'astro:content';
import Layout from '../../signal/Layout.astro';
import Hero from '../../signal/components/Hero.astro';
import Proof from '../../signal/components/Proof.astro';
import Focus from '../../signal/components/Focus.astro';
import Highlights from '../../signal/components/Highlights.astro';
import Field from '../../signal/components/Field.astro';

const docs = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="The Signal"
  description="Alternative homepage direction — Pelumi Igbalajobi, global policy analyst."
>
  <Hero />
  <Proof />
  <Focus />
  <Highlights docs={docs} id="work" />
  <Field />
</Layout>
