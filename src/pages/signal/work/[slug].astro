---
import { getCollection, render } from 'astro:content';
import Layout from '../../../signal/Layout.astro';
import CaseHeader from '../../../signal/components/CaseHeader.astro';
import DocPreview from '../../../signal/components/DocPreview.astro';
import Field from '../../../signal/components/Field.astro';

export async function getStaticPaths() {
  const docs = await getCollection('work');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const d = doc.data;

const allDocs = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const total = allDocs.length;
const i = allDocs.findIndex((x) => x.id === doc.id);
const prev = allDocs[(i - 1 + total) % total];
const next = allDocs[(i + 1) % total];
const related = allDocs
  .filter((x) => x.id !== doc.id && x.data.focusAreas.some((fa) => d.focusAreas.includes(fa)))
  .slice(0, 2);

const counter = (o: number) => `${String(o).padStart(2, '0')} — ${String(total).padStart(2, '0')}`;
---

<Layout title={d.title} description={d.question}>
  <CaseHeader doc={doc} />

  <article class="sg-case sg-band sg-band--bone">
    <section class="sg-case__rec grid-12">
      <div class="col-span-9">
        <span class="sg-mono--12 sg-mono sg-case__label">Recommendation</span>
        <p class="sg-title sg-case__rec-text">{d.recommendation}</p>
      </div>
    </section>

    <section class="sg-case__context grid-12">
      <div class="col-span-8">
        <span class="sg-mono--12 sg-mono sg-case__label">Context</span>
        <div class="sg-body sg-case__prose"><Content /></div>
      </div>
    </section>

    {d.options && (
      <section class="sg-case__options">
        <span class="sg-mono--12 sg-mono sg-case__label">Options considered</span>
        <div class="sg-case__options-grid grid-12">
          {d.options.map((o) => (
            <div class="sg-case__option col-span-4" class:list={{ 'sg-case__option--chosen': o.verdict === 'chosen' }}>
              {o.verdict === 'chosen' && <span class="sg-mono sg-case__option-tag">Recommended</span>}
              <h3 class="sg-title sg-case__option-title">{o.title}</h3>
              <p class="sg-body sg-case__option-body">{o.summary}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="sg-case__shows">
      <span class="sg-mono--12 sg-mono sg-case__label">What this shows</span>
      <ul class="sg-case__shows-list">
        {d.shows.map((s, n) => (
          <li class="sg-case__shows-item">
            <span class="sg-mono sg-case__shows-num">{String(n + 1).padStart(2, '0')}</span>
            <span class="sg-case__shows-text">{s}</span>
          </li>
        ))}
      </ul>
    </section>

    <DocPreview doc={doc} />

    {related.length > 0 && (
      <section class="sg-case__related">
        <span class="sg-mono--12 sg-mono sg-case__label">Related</span>
        <div class="sg-case__related-rows">
          {related.map((r) => (
            <a href={`/signal/work/${r.id}/`} class="sg-case__related-row grid-12">
              <span class="sg-mono col-span-2">{String(r.data.order).padStart(2, '0')} · {r.data.format}</span>
              <span class="sg-title sg-case__related-title col-span-10">{r.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="sg-case__nav grid-12" aria-label="Other case studies">
      <a href={`/signal/work/${prev.id}/`} class="sg-stack col-span-6">
        <span class="sg-stack__label">← {counter(prev.data.order)}</span>
        <span class="sg-stack__sub">{prev.data.title}</span>
      </a>
      <a href={`/signal/work/${next.id}/`} class="sg-stack col-span-6">
        <span class="sg-stack__label">{counter(next.data.order)} →</span>
        <span class="sg-stack__sub">{next.data.title}</span>
      </a>
    </nav>
  </article>

  <Field />
</Layout>

<style>
  .sg-case > section + section,
  .sg-case > nav { margin-top: var(--sg-band); }
  .sg-case__label { display: block; opacity: 0.6; margin-bottom: 14px; }

  .sg-case__rec-text { font-size: 36px; font-weight: 700; }
  .sg-case__prose { font-size: 20px; max-width: 62ch; }
  .sg-case__prose :global(p + p) { margin-top: 1em; }
  .sg-case__prose :global(strong) { font-weight: 800; }
  .sg-case__prose :global(em) { font-style: italic; }

  .sg-case__options-grid { row-gap: var(--space-md); }
  .sg-case__option {
    border: 2px solid var(--sg-ink);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sg-case__option--chosen { background: var(--sg-ink); color: var(--sg-bone); }
  .sg-case__option-tag { color: var(--sg-orange); }
  .sg-case__option-title { font-size: 22px; }
  .sg-case__option-body { font-size: 15px; }

  .sg-case__shows-list { border-top: 1px solid var(--sg-ink); }
  .sg-case__shows-item {
    display: flex;
    gap: 20px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--sg-ink);
  }
  .sg-case__shows-num { color: var(--sg-orange); flex: none; }
  .sg-case__shows-text {
    font-size: 20px;
    font-weight: 700;
    font-stretch: 90%;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .sg-case__related-rows { border-top: 1px solid var(--sg-ink); }
  .sg-case__related-row {
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--sg-ink);
  }
  .sg-case__related-title { font-size: 24px; }

  .sg-case__nav { row-gap: 12px; }
  .sg-case__nav .sg-stack:last-child { text-align: right; align-items: flex-end; }

  @media (max-width: 640px) {
    .sg-case__rec-text { font-size: 24px; }
    .sg-case__prose { font-size: 17px; }
    .sg-case__shows-text { font-size: 16px; }
    .sg-case__related-title { font-size: 18px; }
    .sg-case__nav .sg-stack:last-child { text-align: left; align-items: flex-start; }
  }
</style>
