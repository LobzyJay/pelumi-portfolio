---
// The web version of her résumé. Every line here comes from resume.ts, which
// is checked against her PDF; the PDF itself is the download.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { education, experience, certifications, languages, skills } from '../data/resume';

const mailHref = `mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.emailSubject)}`;
---

<Layout
  title="Résumé"
  description={`Résumé of ${site.name}: Master of Global Policy (LBJ School, UT Austin), anti-trafficking and advocacy experience, languages and skills.`}
>
  <section class="top pi-wrap">
    <div class="head">
      <div class="head__strip" aria-hidden="true"></div>
      <div class="head__body">
        <div class="head__title">
          <span class="pi-label pi-label--12 head__kicker">Program and policy professional · {site.city}</span>
          <h1 class="head__word">Résumé</h1>
        </div>
        <div class="head__actions">
          <a class="pi-btn pi-btn--pink" href={site.contact.resumePdf} download="Igbalajobi-Oluwapelumi-Resume.pdf">
            Download PDF<Icon name="arrow-down" />
          </a>
          <span class="pi-label pi-label--12 head__by">{site.name} · 2026</span>
        </div>
      </div>
    </div>
  </section>

  <section class="cv pi-wrap">
    <div class="intro">
      <p class="intro__lead">{site.positioning}</p>
      <ul class="intro__contact pi-label">
        <li><a href={mailHref}><Icon name="mail" size={16} />{site.contact.email}</a></li>
        <li>
          <a href={site.contact.linkedin} target="_blank" rel="noopener me">
            <Icon name="arrow-up-right" size={16} />{site.contact.linkedinLabel}
          </a>
        </li>
        <li><span><Icon name="pin" size={16} />{site.city}</span></li>
      </ul>
    </div>

    <div class="block">
      <h2 class="block__head pi-label pi-label--12">01 Education</h2>
      {education.map((e) => (
        <div class="entry">
          <span class="entry__date pi-label pi-label--12">{e.dates}</span>
          <div class="entry__body">
            <h3 class="entry__title">{e.title}</h3>
            <span class="entry__org pi-body">{e.detail}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="block">
      <h2 class="block__head pi-label pi-label--12">02 Experience</h2>
      {experience.map((r) => (
        <div class="entry">
          <span class="entry__date pi-label pi-label--12">{r.dates}</span>
          <div class="entry__body">
            <h3 class="entry__title">{r.title}</h3>
            <span class="entry__org pi-body">{r.org} · {r.place}</span>
            <ul class="bullets">
              {r.bullets.map((b) => (
                <li class="pi-body"><span class="bullets__mark" aria-hidden="true"></span><span>{b}</span></li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <div class="block">
      <h2 class="block__head block__head--spaced pi-label pi-label--12">03 Certifications, languages &amp; skills</h2>
      <div class="cards">
        <div class="box">
          <span class="box__k pi-label">Certifications</span>
          <ul>
            {certifications.map((c) => (
              <li class="line">
                <span class="line__a">{c.name}</span>
                {c.issuer && <span class="line__b pi-body">{c.issuer}</span>}
              </li>
            ))}
          </ul>
        </div>

        <div class="box box--ink">
          <span class="box__k pi-label">Languages</span>
          <ul>
            {languages.map((l) => (
              <li class="line">
                <span class="line__a">{l.name}</span>
                <span class="line__b pi-body">{l.level}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="box">
          <span class="box__k pi-label">Skills</span>
          <div class="skills">
            {skills.map((g) => (
              <div class="skills__group">
                <span class="skills__name pi-body">{g.group}</span>
                <ul class="skills__items">
                  {g.items.map((s) => <li class="pi-body">{s}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- header: arches strip over an ink card ---- */
  .top {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding-top: 108px;
  }
  .head { border-radius: 20px; overflow: hidden; background: var(--ink); color: var(--cream); }
  .head__strip {
    height: 180px;
    background: var(--salmon) url('../assets/pattern/pi-arches.svg') bottom center / cover no-repeat;
  }
  .head__body {
    padding: 40px 56px 48px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }
  .head__title { display: flex; flex-direction: column; gap: 16px; }
  .head__kicker { color: var(--pink-soft); }
  .head__word {
    font-size: clamp(96px, 11vw, 160px);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  .head__actions { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }
  .head__by { color: var(--pink-soft); }

  /* ---- body ---- */
  .cv {
    max-width: calc(1600px + var(--gutter) * 2);
    margin-inline: auto;
    padding-block: 64px;
  }
  .intro { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
  .intro__lead {
    grid-column: span 8;
    font-size: 34px;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .intro__contact {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .intro__contact a, .intro__contact span {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
  }

  .block { margin-top: 64px; }
  .block__head {
    display: block;
    padding-bottom: 12px;
    border-bottom: 1.5px solid var(--ink);
    color: var(--plum);
  }
  .block__head--spaced { margin-bottom: 24px; }

  .entry {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    padding: 24px 0;
    border-bottom: 1.5px dashed var(--hair);
    align-items: baseline;
  }
  .entry__date { grid-column: span 3; letter-spacing: 0.08em; line-height: 1.6; }
  .entry__body { grid-column: span 9; display: flex; flex-direction: column; gap: 6px; }
  .entry__title { font-size: 24px; font-weight: 400; line-height: 1.15; letter-spacing: -0.025em; }
  .entry__org { font-size: 15px; color: var(--plum); }

  .bullets { margin-top: 10px; display: flex; flex-direction: column; gap: 8px; max-width: 72ch; }
  .bullets li { display: flex; gap: 12px; font-size: 15px; line-height: 1.5; }
  .bullets__mark {
    flex-shrink: 0;
    width: 10px;
    height: 4px;
    margin-top: 10px;
    border-radius: 2px;
    background: var(--pink);
  }

  /* ---- cards ---- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    align-items: stretch;
  }
  .box {
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #fff;
    border: 1.5px solid rgba(43, 21, 23, 0.12);
  }
  .box--ink { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .box__k { color: var(--plum); }
  .box--ink .box__k { color: var(--pink-soft); }

  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-top: 1.5px dashed rgba(43, 21, 23, 0.2);
  }
  .box--ink .line { border-top-color: rgba(251, 168, 238, 0.35); }
  .line__a { font-size: 20px; letter-spacing: -0.015em; }
  .line__b { font-size: 14px; color: var(--pink-deep); text-align: right; }
  .box--ink .line__b { color: var(--pink-soft); }

  .skills { display: flex; flex-direction: column; gap: 14px; }
  .skills__group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 12px;
    border-top: 1.5px dashed rgba(43, 21, 23, 0.2);
  }
  .skills__name { font-size: 13px; color: var(--plum); }
  .skills__items { display: flex; flex-wrap: wrap; gap: 6px; }
  .skills__items li {
    background: var(--tint);
    color: var(--pink-deep);
    border-radius: 999px;
    padding: 7px 13px;
    font-size: 14px;
    line-height: 1;
  }

  /* ---- phone / tablet ---- */
  @media (max-width: 1023px) {
    .top { padding-top: 84px; }
    .head { border-radius: 18px; }
    .head__strip { height: 120px; }
    .head__body { flex-direction: column; align-items: stretch; padding: 28px 24px 24px; gap: 24px; }
    .head__word { font-size: clamp(72px, 22vw, 140px); }
    .head__actions { align-items: stretch; }
    .head__actions .pi-btn { width: 100%; }
    .head__by { text-align: center; }

    .cv { padding-block: 40px; }
    .intro { display: flex; flex-direction: column; gap: 20px; }
    .intro__lead { font-size: 26px; }
    .intro__contact { text-align: left; }
    .intro__contact a, .intro__contact span { justify-content: flex-start; }

    .block { margin-top: 40px; }
    .entry { display: flex; flex-direction: column; gap: 6px; padding: 20px 0; }
    .entry__title { font-size: 20px; line-height: 1.2; letter-spacing: -0.02em; }
    .cards { grid-template-columns: 1fr; gap: 12px; }
    .box { border-radius: 16px; padding: 24px; }
  }
</style>
